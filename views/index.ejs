                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price" id="precio-<%= producto.id %>">
                                    <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                                </div>
                                <% if (producto.variantes && producto.variantes.length > 0) { %>
                                    <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                                        <% producto.variantes.forEach(v => { %>
                                            <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                                        <% }) %>
                                    </select>
                                <% } %>
                                
                                <div style="display: flex; align-items: center; gap: 10px; margin-top: 12px;">
