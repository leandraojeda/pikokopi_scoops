<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Piko Kopi Shop 🌸</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --piko-pink: #ff85a2;
            --piko-pastel: #fff0f3;
            --piko-dark: #444;
        }

        /* Estilos base para modales */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }
        .modal-overlay.active { display: flex; }
        .modal-content {
            background: white;
            width: 90%;
            max-width: 420px;
            padding: 25px;
            border-radius: 25px;
            position: relative;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            animation: slideUp 0.3s ease-out;
        }
        @keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Botones extras */
        .btn-ws {
            background-color: #25D366;
            color: white;
            border: none;
            padding: 15px;
            border-radius: 12px;
            font-weight: 800;
            cursor: pointer;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: 0.3s;
        }
        .btn-ws:hover { background-color: #1eb954; transform: scale(1.02); }
        .btn-secundario {
            background-color: #f0f0f0;
            color: #555;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
        }
        .cant-mini {
            background: var(--piko-pink);
            color: white;
            border: none;
            border-radius: 5px;
            width: 28px;
            height: 28px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="nav-left">
        <a href="/" class="logo">PIKO <span>KOPI</span></a>
    </div>
    <div class="nav-center">
        <button class="filter-btn active" onclick="filtrar('todos', this)">TODOS</button>
        <button class="filter-btn" onclick="filtrar('scoops', this)">SCOOPS</button>
        <button class="filter-btn" onclick="filtrar('productos', this)">PRODUCTOS</button>
        <button class="filter-btn" onclick="filtrar('packs', this)">PACKS</button>
    </div>
    <div class="nav-right">
        <div class="header-total"><span id="nav-total-bs">0.00</span> BS</div>
        <div class="cart-wrapper" onclick="abrirCarrito()">
            <i class="fa-solid fa-cart-shopping"></i>
            <span id="cart-count-badge">0</span>
        </div>
    </div>
</nav>

<section class="banner-section">
    <img src="/img/banner.jpg" alt="Piko Kopi Banner">
</section>

<main class="productos-container" id="main-container">
    <% if (typeof productos !== 'undefined' && productos.length > 0) { %>
        <% 
            const categorias = [
                { id: 'todos', data: productos },
                { id: 'scoops', data: productos.filter(p => p.cat === 'scoops') },
                { id: 'productos', data: productos.filter(p => p.cat === 'productos') },
                { id: 'packs', data: productos.filter(p => p.cat === 'packs') }
            ];
        %>

        <% categorias.forEach(catObj => { %>
            <div id="vista-<%= catObj.id %>" class="vista-productos" style="<%= catObj.id === 'todos' ? '' : 'display: none;' %> grid-column: 1 / -1;">
                <div class="productos-container">
                    <% catObj.data.forEach(producto => { %>
                        <div class="card item-producto">
                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price">
                                    <span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS
                                </div>
                                <div class="cantidad-selector" style="margin-bottom: 10px;">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" style="width:100%" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR</button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    <% } %>
</main>

<div class="modal-overlay" id="modal-carrito">
    <div class="modal-content">
        <button class="close-modal" onclick="cerrarCarrito()">✕</button>
        <div id="paso-1">
            <h2 style="color: var(--piko-pink); text-align: center; font-weight: 800; margin-bottom: 15px;">Tu Carrito ✨</h2>
            <div id="lista-carrito" style="max-height: 350px; overflow-y: auto;"></div>
            <div style="border-top: 1px solid #eee; padding-top: 15px; margin-top: 10px;">
                <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 1.2rem;">
                    <span>TOTAL</span>
                    <span><span id="total-modal">0.00</span> BS</span>
                </div>
                <button class="btn-add" style="width:100%; margin-top: 15px;" onclick="irAPaso2()">CONTINUAR</button>
            </div>
        </div>

        <div id="paso-2" style="display: none;">
            <button onclick="irAPaso1()" style="background:none; border:none; color: #999; margin-bottom: 10px; cursor:pointer;"><i class="fa-solid fa-arrow-left"></i> Volver</button>
            <h2 style="text-align: center; color: var(--piko-pink); font-weight: 800;">Datos de Envío</h2>
            <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 15px;">
                <input type="text" id="f-nombre" placeholder="Nombre completo" required style="padding:12px; border-radius:10px; border:1px solid #ddd;">
                <input type="tel" id="f-celular" placeholder="WhatsApp (ej. 77123456)" required style="padding:12px; border-radius:10px; border:1px solid #ddd;">
                <select id="f-ciudad" style="padding:12px; border-radius:10px; border:1px solid #ddd;">
                    <option value="Sucre">Sucre</option>
                    <option value="Potosí">Potosí</option>
                    <option value="La Paz">La Paz</option>
                    <option value="Santa Cruz">Santa Cruz</option>
                    <option value="Cochabamba">Cochabamba</option>
                </select>
                <button type="button" id="btn-piko-final" class="btn-add" style="width: 100%;" onclick="enviarPedido()">CONFIRMAR PEDIDO</button>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="modal-exito">
    <div class="modal-content" style="text-align: center; padding: 35px;">
        <div style="font-size: 4.5rem; color: #75e097; margin-bottom: 15px;">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h2 style="color: var(--piko-pink); font-weight: 800; margin-bottom: 10px;">¡Pedido Hecho!</h2>
        <p style="color: #666; font-size: 0.9rem; margin-bottom: 25px;">Tu recibo se ha descargado. Por favor envíalo por WhatsApp para coordinar el pago.</p>
        
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <button id="btn-ws-final" class="btn-ws">
                <i class="fa-brands fa-whatsapp"></i> ENVIAR A WHATSAPP
            </button>
            <button id="btn-re-descargar" class="btn-secundario">
                <i class="fa-solid fa-download"></i> VOLVER A DESCARGAR RECIBO
            </button>
            <button onclick="location.reload()" style="background:none; border:none; color:#bbb; margin-top:10px; cursor:pointer;">Cerrar y volver a la tienda</button>
        </div>
    </div>
</div>

<script>
let carrito = JSON.parse(localStorage.getItem('piko_cart')) || [];
let urlReciboActual = null; // Para guardar el blob del PDF

document.addEventListener('DOMContentLoaded', () => { actualizarUI(); });

function guardarCarrito() { localStorage.setItem('piko_cart', JSON.stringify(carrito)); }
function sumarCantidad(id) { const input = document.getElementById(`cant-${id}`); input.value = parseInt(input.value) + 1; }
function restarCantidad(id) { const input = document.getElementById(`cant-${id}`); if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1; }

function agregarAlCarrito(id, titulo, img) {
    const cantidad = parseInt(document.getElementById(`cant-${id}`).value);
    const precio = parseFloat(document.getElementById(`precio-${id}`).innerText);
    const existe = carrito.find(p => p.id === id);
    if (existe) { existe.cantidad += cantidad; } 
    else { carrito.push({ id, titulo, img, precio, cantidad, variante: "Único" }); }
    document.getElementById(`cant-${id}`).value = 1;
    Swal.fire({ title: "¡Añadido!", icon: "success", timer: 800, showConfirmButton: false });
    actualizarUI();
}

function cambiarCantidadCarrito(idx, delta) {
    if (carrito[idx].cantidad + delta > 0) {
        carrito[idx].cantidad += delta;
        actualizarUI();
    }
}

function eliminarDelCarrito(idx) {
    carrito.splice(idx, 1);
    actualizarUI();
}

function actualizarUI() {
    let total = 0, unidades = 0;
    const lista = document.getElementById('lista-carrito');
    lista.innerHTML = carrito.map((p, idx) => {
        const sub = p.precio * p.cantidad;
        total += sub; unidades += p.cantidad;
        return `
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:15px; border-bottom:1px solid #f9f9f9; padding-bottom:10px;">
                <img src="${p.img}" style="width:50px; height:50px; border-radius:10px; object-fit:cover;">
                <div style="flex:1">
                    <div style="font-weight:600; font-size:0.85rem; line-height:1.2;">${p.titulo}</div>
                    <div style="display:flex; align-items:center; gap:10px; margin-top:5px;">
                        <button onclick="cambiarCantidadCarrito(${idx}, -1)" class="cant-mini">-</button>
                        <span style="font-weight:bold">${p.cantidad}</span>
                        <button onclick="cambiarCantidadCarrito(${idx}, 1)" class="cant-mini">+</button>
                    </div>
                </div>
                <div style="text-align:right">
                    <div style="font-weight:800; color:var(--piko-pink);">${sub.toFixed(2)} BS</div>
                    <button onclick="eliminarDelCarrito(${idx})" style="background:none; border:none; color:#ff4d4d; font-size:0.7rem; cursor:pointer;">Eliminar</button>
                </div>
            </div>`;
    }).join('');
    if (carrito.length === 0) lista.innerHTML = "<p style='text-align:center; color:#999; padding:20px;'>Tu carrito está vacío 🌸</p>";
    document.getElementById('nav-total-bs').innerText = total.toFixed(2);
    document.getElementById('total-modal').innerText = total.toFixed(2);
    document.getElementById('cart-count-badge').innerText = unidades;
    guardarCarrito();
}

async function enviarPedido() {
    const btn = document.getElementById('btn-piko-final');
    const nombre = document.getElementById('f-nombre').value.trim();
    const celular = document.getElementById('f-celular').value.trim();
    const ciudad = document.getElementById('f-ciudad').value;
    const total = document.getElementById('total-modal').innerText;
    const nroPedido = (Math.floor(Math.random() * 9000) + 1000).toString();

    if(!nombre || !celular || carrito.length === 0) {
        return Swal.fire("¡Atención!", "Completa tus datos.", "warning");
    }

    btn.disabled = true; btn.innerText = "PROCESANDO...";

    try {
        const response = await fetch('/confirmar-pedido', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ nombre, celular, ciudad, total, carrito, nro: nroPedido })
        });

        if (response.ok) {
            const blob = await response.blob();
            urlReciboActual = window.URL.createObjectURL(blob);
            
            // Descarga automática
            const a = document.createElement('a');
            a.href = urlReciboActual;
            a.download = `Recibo_PikoKopi_${nroPedido}.pdf`;
            a.click();

            // Interfaz de éxito
            cerrarCarrito();
            document.getElementById('modal-exito').classList.add('active');

            // Configurar botones finales
            document.getElementById('btn-ws-final').onclick = () => {
                const texto = `¡Hola Piko Kopi! 🌸\nHe realizado un pedido:\n*Nombre:* ${nombre}\n*Nro:* #${nroPedido}\n*Total:* ${total} BS.\nAdjunto mi recibo PDF.`;
                window.open(`https://wa.me/59177143374?text=${encodeURIComponent(texto)}`, '_blank');
            };

            document.getElementById('btn-re-descargar').onclick = () => {
                const link = document.createElement('a');
                link.href = urlReciboActual;
                link.download = `Recibo_PikoKopi_${nroPedido}.pdf`;
                link.click();
            };

            carrito = []; actualizarUI();
        } else { throw new Error("Error servidor"); }
    } catch (e) {
        Swal.fire("Error", "No se pudo procesar el pedido.", "error");
    } finally {
        btn.disabled = false; btn.innerText = "CONFIRMAR PEDIDO";
    }
}

function filtrar(cat, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.vista-productos').forEach(v => v.style.display = 'none');
    document.getElementById(`vista-${cat}`).style.display = 'block';
}
function abrirCarrito() { document.getElementById('modal-carrito').classList.add('active'); }
function cerrarCarrito() { document.getElementById('modal-carrito').classList.remove('active'); }
function irAPaso2() { 
    if(carrito.length === 0) return;
    document.getElementById('paso-1').style.display = 'none'; 
    document.getElementById('paso-2').style.display = 'block'; 
}
function irAPaso1() { 
    document.getElementById('paso-2').style.display = 'none'; 
    document.getElementById('paso-1').style.display = 'block'; 
}
</script>
</body>
</html>