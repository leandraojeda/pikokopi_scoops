<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Piko Kopi Shop 🌸</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root { --piko-pink: #ff85a2; --piko-pastel: #fff5f7; }
        .cart-wrapper { position: relative; cursor: pointer; display: inline-block; }
        #cart-count-badge {
            position: absolute; top: -5px; right: -8px;
            background: var(--piko-pink); color: white;
            font-size: 0.65rem; font-weight: 800;
            min-width: 18px; height: 18px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid white; transform: scale(0); opacity: 0;
            transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        #cart-count-badge.visible { transform: scale(1); opacity: 1; }
        .btn-remove { background: none; border: none; color: #ffbcbc; cursor: pointer; font-size: 1.1rem; transition: 0.2s; }
        .btn-remove:hover { color: var(--piko-pink); }
        .hidden { display: none; }
        .input-piko { padding: 10px; border-radius: 12px; border: 1px solid #ffdae0; font-family: 'Poppins'; outline: none; }
        .cant-input { width: 45px; padding: 8px; border-radius: 8px; border: 1px solid #ffdae0; text-align: center; font-weight: 600; color: var(--piko-pink); }
        
        /* Botones de cantidad en carrito */
        .btn-qty { width: 24px; height: 24px; border-radius: 50%; border: 1px solid #ffdae0; background: white; color: var(--piko-pink); cursor: pointer; font-weight: bold; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
        .btn-qty-plus { background: var(--piko-pink); color: white; border: none; }
        .btn-qty:active { transform: scale(0.9); }
    </style>
</head>
<body>

<%- include('partials/header') %>

<nav class="navbar">
    <div class="nav-left">
        <a href="/" class="logo">PIKO <span>KOPI</span></a>
    </div>
    
    <div class="nav-center">
        <button class="filter-btn active" onclick="filtrar('todos', this)">TODOS</button>
        <button class="filter-btn" onclick="filtrar('scoops', this)">SCOOPS</button>
        <button class="filter-btn" onclick="filtrar('productos', this)">STATIONERY</button>
    </div>

    <div class="nav-right" style="display: flex; align-items: center; gap: 15px;">
        <div style="font-weight: 800; color: var(--piko-pink);"><span id="nav-total-bs">0</span> BS</div>
        <div class="cart-wrapper" onclick="abrirCarrito()">
            <i class="fa-solid fa-cart-shopping" style="font-size: 1.3rem;"></i>
            <span id="cart-count-badge">0</span>
        </div>
    </div>
</nav>

<main class="productos-container">
    <% if (typeof productos !== 'undefined' && productos.length > 0) { %>
        <% productos.forEach(producto => { %>
            <div class="card item-producto" data-categoria="<%= producto.cat %>">
                <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                <div class="card-info">
                    <h3><%= producto.titulo %></h3>
                    <div class="price" id="precio-<%= producto.id %>">
                        <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                    </div>
                    
                    <% if (producto.variantes && producto.variantes.length > 0) { %>
                        <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                            <% producto.variantes.forEach(v => { %>
                                <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                            <% }) %>
                        </select>
                    <% } %>
                    
                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
                        <input type="number" id="cant-<%= producto.id %>" class="cant-input" value="1" min="1" max="99">
                        <button class="btn-add" style="flex: 1; margin-top: 0;" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR 🛒</button>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</main>

<div class="modal-overlay" id="modal-carrito" style="display: none;">
    <div class="modal-content" style="max-width: 500px; border-radius: 20px;">
        <span class="close-modal" onclick="cerrarCarrito()">&times;</span>
        
        <div id="paso-1">
            <h2 style="color: var(--piko-pink); text-align: center; font-weight: 800;">Tu Carrito ✨</h2>
            <div id="lista-carrito" style="max-height: 350px; overflow-y: auto; margin: 15px 0; padding-right: 5px;"></div>
            <div style="border-top: 2px solid var(--piko-pastel); padding-top: 15px;">
                <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 1.2rem;">
                    <span>TOTAL:</span>
                    <span><span id="total-modal">0</span> BS</span>
                </div>
                <button class="btn-add" style="width:100%; margin-top: 15px;" onclick="irAPaso2()">CONTINUAR AL ENVÍO 🚚</button>
            </div>
        </div>

        <div id="paso-2" style="display: none;">
            <button onclick="irAPaso1()" style="background:none; border:none; cursor:pointer; color: gray; margin-bottom: 10px;"><i class="fa-solid fa-arrow-left"></i> Volver</button>
            <h2 style="text-align: center; margin-bottom: 15px; color: var(--piko-pink);">🛍️ Datos de Envío</h2>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <input type="text" id="f-nombre" class="input-piko" placeholder="Tu Nombre Completo" required>
                <input type="tel" id="f-celular" class="input-piko" placeholder="WhatsApp (7XXXXXXX)" required>
                
                <label style="font-size: 0.8rem; font-weight: 600;">Ciudad de Destino:</label>
                <select id="f-ciudad" class="input-piko" onchange="gestionarLogicaEnvio()">
                    <option value="Sucre">Sucre</option>
                    <option value="La Paz">La Paz</option>
                    <option value="Santa Cruz">Santa Cruz</option>
                    <option value="Cochabamba">Cochabamba</option>
                    <option value="Oruro">Oruro</option>
                    <option value="Potosi">Potosí</option>
                    <option value="Tarija">Tarija</option>
                </select>

                <div id="opciones-sucre">
                    <select id="envio-sucre" class="input-piko">
                        <option value="Recojo Plaza 25 de Mayo (Gratis)">Recojo Plaza 25 de Mayo (Gratis)</option>
                        <option value="Delivery Sucre (10 BS)">Delivery a domicilio (10 BS)</option>
                    </select>
                </div>

                <div id="opciones-nacional" class="hidden">
                    <select id="envio-nacional" class="input-piko" onchange="verificarOtroTransporte()"></select>
                    <input type="text" id="otro-transporte" class="input-piko hidden" placeholder="¿Qué transportadora prefieres?" style="margin-top:5px;">
                </div>

                <div style="margin-top: 10px; border-top: 2px solid var(--piko-pastel); padding-top: 10px;">
                    <h3 style="color: var(--piko-pink); text-align: right;">Total Final: <span id="total-final">0</span> BS</h3>
                    <button type="button" id="btn-piko-final" class="btn-add" style="width: 100%; padding: 15px;" onclick="enviarAlExcel()">
                        CONFIRMAR PEDIDO 🌸
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    let carrito = [];
    let total = 0;

    const transportadoras = {
        "La Paz": ["Trans Copacabana", "El Dorado", "Bolivar", "Otro (Escribir)"],
        "Santa Cruz": ["Flota Bolivar", "Trans Copacabana S.A.", "Otro (Escribir)"],
        "General": ["Trans Copacabana", "El Dorado", "Otro (Escribir)"]
    };

    function agregarAlCarrito(id, titulo, img) {
        const precioUnitario = parseFloat(document.getElementById(`precio-${id}`).innerText);
        const cantidad = parseInt(document.getElementById(`cant-${id}`).value) || 1;
        const sel = document.getElementById(`select-${id}`);
        const variante = sel ? sel.options[sel.selectedIndex].getAttribute('data-nombre') : "";
        
        const subtotal = precioUnitario * cantidad;

        carrito.push({ 
            idU: Date.now(), 
            titulo, 
            img, 
            variante, 
            precio: precioUnitario, 
            cantidad, 
            subtotal 
        });

        total += subtotal;
        document.getElementById(`cant-${id}`).value = 1;
        actualizarUI();

        const btn = event.target;
        btn.innerText = "¡AÑADIDO! ✨";
        setTimeout(() => btn.innerText = "AÑADIR 🛒", 800);
    }

    function cambiarCantidad(idU, cambio) {
        const i = carrito.findIndex(p => p.idU === idU);
        if (i > -1) {
            const nuevaCant = carrito[i].cantidad + cambio;
            if (nuevaCant <= 0) return eliminarDelCarrito(idU);
            
            total -= carrito[i].subtotal;
            carrito[i].cantidad = nuevaCant;
            carrito[i].subtotal = carrito[i].precio * nuevaCant;
            total += carrito[i].subtotal;
            actualizarUI();
        }
    }

    function eliminarDelCarrito(idU) {
        const i = carrito.findIndex(p => p.idU === idU);
        if(i > -1) { total -= carrito[i].subtotal; carrito.splice(i, 1); }
        actualizarUI();
    }

    function actualizarUI() {
        document.getElementById('nav-total-bs').innerText = total.toFixed(2);
        document.getElementById('total-modal').innerText = total.toFixed(2);
        
        const b = document.getElementById('cart-count-badge');
        const unidades = carrito.reduce((sum, p) => sum + p.cantidad, 0);
        b.innerText = unidades;
        b.classList.toggle('visible', unidades > 0);
        
        const l = document.getElementById('lista-carrito');
        l.innerHTML = carrito.length === 0 ? '<p style="text-align:center; padding:20px;">Tu carrito está vacío 🌸</p>' : 
            carrito.map(p => `
                <div style="display:flex; align-items:center; padding:12px 0; border-bottom:1px solid #fdf0f2; gap: 12px;">
                    <img src="${p.img}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 12px; border: 1px solid #ffdae0;">
                    <div style="flex: 1;">
                        <div style="font-weight:600; font-size:0.85rem; color: #444;">${p.titulo}</div>
                        <small style="color:gray;">${p.variante ? p.variante : 'Único'}</small>
                        <div style="color:var(--piko-pink); font-weight:800;">${p.subtotal.toFixed(2)} BS</div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <button class="btn-qty" onclick="cambiarCantidad(${p.idU}, -1)">-</button>
                        <span style="font-weight:700; min-width:15px; text-align:center;">${p.cantidad}</span>
                        <button class="btn-qty btn-qty-plus" onclick="cambiarCantidad(${p.idU}, 1)">+</button>
                    </div>
                    <button class="btn-remove" onclick="eliminarDelCarrito(${p.idU})"><i class="fa-solid fa-trash-can"></i></button>
                </div>`).join('');
    }

    function gestionarLogicaEnvio() {
        const ciudad = document.getElementById('f-ciudad').value;
        const divSucre = document.getElementById('opciones-sucre');
        const divNacional = document.getElementById('opciones-nacional');
        if (ciudad === "Sucre") {
            divSucre.classList.remove('hidden');
            divNacional.classList.add('hidden');
        } else {
            divSucre.classList.add('hidden');
            divNacional.classList.remove('hidden');
            const opciones = transportadoras[ciudad] || transportadoras["General"];
            document.getElementById('envio-nacional').innerHTML = opciones.map(o => `<option value="${o}">${o}</option>`).join('');
            verificarOtroTransporte();
        }
    }

    function verificarOtroTransporte() {
        const val = document.getElementById('envio-nacional').value;
        document.getElementById('otro-transporte').classList.toggle('hidden', val !== "Otro (Escribir)");
    }

    async function enviarAlExcel() {
        const btn = document.getElementById('btn-piko-final');
        const nombre = document.getElementById('f-nombre').value.trim();
        const celular = document.getElementById('f-celular').value.trim();
        if(!nombre || !celular) return Swal.fire("¡Espera!", "Dime tu nombre y cel para coordinar 🌸", "warning");

        const ciudad = document.getElementById('f-ciudad').value;
        let transporte = (ciudad === "Sucre") ? document.getElementById('envio-sucre').value : 
                        (document.getElementById('envio-nacional').value === "Otro (Escribir)" ? document.getElementById('otro-transporte').value : document.getElementById('envio-nacional').value);

        const data = {
            nombre, celular, ciudad, transporte,
            total: total.toFixed(2) + " BS",
            carrito: carrito,
            productosTexto: carrito.map(p => `${p.cantidad}x ${p.titulo}${p.variante ? ' ('+p.variante+')' : ''}`).join(', ')
        };

        try {
            btn.disabled = true; btn.innerText = "🌸 GUARDANDO...";
            const res = await fetch('/confirmar-pedido', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            });

            if (res.ok) {
                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Pedido_PikoKopi_${nombre.replace(/\s+/g, '_')}.pdf`;
                document.body.appendChild(a); a.click();
                
                await Swal.fire({ title: '¡Pedido Listo! ✨', text: 'Tu recibo se descargó. ¡Escríbeme al WhatsApp para confirmar el pago!', icon: 'success', confirmButtonColor: '#ff85a2' });
                window.location.reload();
            }
        } catch (e) { Swal.fire("Error", "No se pudo conectar con el servidor", "error"); }
        finally { btn.disabled = false; btn.innerText = "CONFIRMAR PEDIDO 🌸"; }
    }

    function irAPaso2() { 
        if(carrito.length === 0) return Swal.fire("¡Carrito vacío!", "Añade algo tierno primero 🌸", "info");
        document.getElementById('paso-1').style.display = 'none';
        document.getElementById('paso-2').style.display = 'block';
        document.getElementById('total-final').innerText = total.toFixed(2);
        gestionarLogicaEnvio();
    }
    function irAPaso1() { document.getElementById('paso-2').style.display = 'none'; document.getElementById('paso-1').style.display = 'block'; }
    function abrirCarrito() { irAPaso1(); document.getElementById('modal-carrito').style.display = 'flex'; }
    function cerrarCarrito() { document.getElementById('modal-carrito').style.display = 'none'; }
    function filtrar(cat, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.item-producto').forEach(i => i.style.display = (cat === 'todos' || i.dataset.categoria === cat) ? 'flex' : 'none');
    }
</script>
</body>
</html>