                    CONFIRMAR PEDIDO 🌸
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    let carrito = [];
    let total = 0;
    let numeroRecibo = '';

    function sumarCantidad(id) {
        const input = document.getElementById(`cant-${id}`);
        input.value = parseInt(input.value) + 1;
    }

    function restarCantidad(id) {
        const input = document.getElementById(`cant-${id}`);
        if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
        }
    }

    function agregarAlCarrito(id, titulo, img) {
        const precio = parseFloat(document.getElementById(`precio-${id}`).innerText);
        const cantidad = parseInt(document.getElementById(`cant-${id}`).value) || 1;
        const sel = document.getElementById(`select-${id}`);
        const variante = sel ? sel.options[sel.selectedIndex].getAttribute('data-nombre') : "";
        
        carrito.push({ idU: Date.now(), titulo, img, variante, precio, cantidad, subtotal: precio * cantidad });
        total += (precio * cantidad);
        actualizarUI();
    }

    function actualizarUI() {
        document.getElementById('nav-total-bs').innerText = total.toFixed(2);
        document.getElementById('total-modal').innerText = total.toFixed(2);
        const unidades = carrito.reduce((sum, p) => sum + p.cantidad, 0);
        const badge = document.getElementById('cart-count-badge');
        badge.innerText = unidades;
        badge.classList.toggle('visible', unidades > 0);
        
        const lista = document.getElementById('lista-carrito');
        lista.innerHTML = carrito.map(p => `
            <div style="display:flex; align-items:center; gap:15px; margin-bottom:15px; border-bottom:1px solid #f9f9f9; padding-bottom:10px;">
                <img src="${p.img}" style="width:50px; border-radius:10px;">
                <div style="flex:1">
                    <div style="font-weight:600; font-size:0.9rem;">${p.titulo}</div>
                    <small style="color:#aaa">${p.variante}</small>
                </div>
                <div style="font-weight:800; color:var(--piko-pink)">${p.subtotal.toFixed(2)}</div>
            </div>
        `).join('');
    }

    function descargarReciboNuevamente(nro, nombre) {
        fetch(`/descargar-recibo/${nro}`)
            .then(res => res.blob())
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Recibo_#${nro}_${nombre}.pdf`;
                a.click();
                
                Swal.fire({
                    icon: 'success',
                    title: 'Recibo descargado',
                    text: 'Tu recibo se ha descargado correctamente',
                    timer: 2000,
                    showConfirmButton: false
                });
            })
            .catch(() => Swal.fire('Error', 'No pudimos descargar el recibo', 'error'));
    }

    async function enviarAlExcel() {
        const btn = document.getElementById('btn-piko-final');
        const nombre = document.getElementById('f-nombre').value;
        const celular = document.getElementById('f-celular').value;
        const ciudad = document.getElementById('f-ciudad').value;

        if(!nombre || !celular) return Swal.fire("¡Ups!", "Completa tus datos 🌸", "warning");

        // Número de pedido estético
        let nro = (parseInt(localStorage.getItem('piko_nro') || "0") + 1).toString().padStart(4, '0');
        numeroRecibo = nro;
        localStorage.setItem('piko_nro', nro);

        btn.disabled = true;
        btn.innerText = "PROCESANDO... ✨";

        try {
            const res = await fetch('/confirmar-pedido', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ 
                    nombre, 
                    celular, 
                    ciudad,
                    total: total.toFixed(2), 
                    carrito,
                    nro: nro
                })
            });

            if (res.ok) {
                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                
                // DESCARGA AUTOMÁTICA
                const a = document.createElement('a');
                a.href = url; 
                a.download = `Recibo_#${nro}_${nombre}.pdf`;
                a.click();

                cerrarCarrito();

                const msg = encodeURIComponent(`¡Hola Piko Kopi! 🌸 Mi pedido es el #${nro}. Soy ${nombre} y ya tengo mi recibo.`);
                
                await Swal.fire({
                    title: '<span style="color:var(--piko-pink)">¡PEDIDO LISTO! ✨</span>',
                    html: `
                        <div style="font-family:Poppins; padding:10px;">
                            <p style="font-size:3rem; margin:0;">📄</p>
                            <h2 style="margin:10px 0; color: var(--piko-pink);">#${nro}</h2>
                            <p style="color:#777; font-size:0.9rem;">Tu recibo se ha descargado automáticamente.</p>
                            <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 20px;">
                                <a href="https://wa.me/591XXXXXXXXX?text=${msg}" target="_blank" class="swal-piko-button">
                                    <i class="fa-brands fa-whatsapp"></i> ENVIAR A WHATSAPP
                                </a>
                                <button class="swal-piko-button-descargar" onclick="descargarReciboNuevamente('${nro}', '${nombre}')">
                                    <i class="fa-solid fa-download"></i> DESCARGAR RECIBO
                                </button>
                            </div>
                        </div>
                    `,
                    showConfirmButton: false,
                    footer: '<a href="javascript:location.reload()" style="color:#aaa; font-size:0.8rem; text-decoration:none;">Hacer otro pedido</a>'
                });
            }
        } catch (e) {
            Swal.fire("Error", "No pudimos generar el recibo 🌸", "error");
        } finally {
            btn.disabled = false;
            btn.innerText = "CONFIRMAR PEDIDO 🌸";
        }
    }

    function irAPaso2() { 
        document.getElementById('paso-1').style.display = 'none'; 
        document.getElementById('paso-2').style.display = 'block'; 
        document.getElementById('total-final').innerText = total.toFixed(2); 
    }
    function irAPaso1() { 
        document.getElementById('paso-2').style.display = 'none'; 
        document.getElementById('paso-1').style.display = 'block'; 
    }
    function abrirCarrito() { 
        document.getElementById('modal-carrito').style.display = 'flex'; 
    }
    function cerrarCarrito() { 
        document.getElementById('modal-carrito').style.display = 'none'; 
    }
    function filtrar(cat, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Ocultar todas las vistas
        document.getElementById('vista-todos').style.display = 'none';
        document.getElementById('vista-scoops').style.display = 'none';
        document.getElementById('vista-productos-cat').style.display = 'none';
        document.getElementById('vista-packs').style.display = 'none';
        
        // Mostrar la vista seleccionada
        if (cat === 'todos') {
            document.getElementById('vista-todos').style.display = 'block';
        } else if (cat === 'scoops') {
            document.getElementById('vista-scoops').style.display = 'grid';
        } else if (cat === 'productos') {
            document.getElementById('vista-productos-cat').style.display = 'grid';
        } else if (cat === 'packs') {
            document.getElementById('vista-packs').style.display = 'grid';
        }
    }
</script>
</body>
</html>