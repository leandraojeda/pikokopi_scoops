<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Piko Kopi Shop 🌸</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --piko-pink: #ff85a2;
            --piko-pastel: #fff0f3;
            --piko-dark: #444;
        }
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }
        .modal-overlay.active { display: flex; }
        .modal-content {
            background: white;
            width: 90%;
            max-width: 450px;
            padding: 25px;
            border-radius: 25px;
            position: relative;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            animation: slideUp 0.35s ease-out;
            max-height: 90vh;
            overflow-y: auto;
        }
        @keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .close-modal {
            position: absolute;
            top: 12px; right: 15px;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #999;
            cursor: pointer;
        }
        .piko-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-family: 'Poppins';
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .piko-input:focus {
            outline: none;
            border-color: var(--piko-pink);
            box-shadow: 0 0 8px rgba(255, 133, 162, 0.2);
        }
        .hidden { display: none; }
    </style>
</head>
<body>

<%- include('partials/header') %>

<!-- NAVBAR -->
<nav class="navbar">
    <div class="nav-left">
        <a href="/" class="logo">PIKO <span>KOPI</span></a>
    </div>
    <div class="nav-center">
        <button class="filter-btn active" onclick="filtrar('todos', this)">TODOS</button>
        <button class="filter-btn" onclick="filtrar('scoops', this)">SCOOPS</button>
        <button class="filter-btn" onclick="filtrar('productos', this)">PRODUCTOS</button>
        <button class="filter-btn" onclick="filtrar('packs', this)">PACKS</button>
    </div>
    <div class="nav-right">
        <div class="header-total"><span id="nav-total-bs">0.00</span> BS</div>
        <div class="cart-wrapper" onclick="abrirCarrito()">
            <i class="fa-solid fa-cart-shopping"></i>
            <span id="cart-count-badge">0</span>
        </div>
    </div>
</nav>

<!-- BANNER -->
<section class="banner-section">
    <picture>
        <source media="(min-width: 1024px)" srcset="/img/banner-pc.png">
        <source media="(min-width: 768px)" srcset="/img/banner-tab.png">
        <img src="/img/banner-cel.png" alt="Piko Kopi Banner Principal">
    </picture>
</section>

<!-- CONTENIDO PRINCIPAL -->
<main id="main-container">
    <% if (typeof productos !== 'undefined' && productos.length > 0) { %>
        <% 
            const scoops = productos.filter(p => p.cat === 'scoops');
            const packs = productos.filter(p => p.cat === 'packs');
            const prods = productos.filter(p => p.cat === 'productos');
        %>

        <!-- VISTA: TODOS -->
        <div id="vista-todos" style="width: 100%;">
            <% if (scoops.length > 0) { %>
                <div class="categoria-titulo">🍦 Scoops</div>
                <div class="productos-container">
                    <% scoops.forEach(producto => { %>
                        <div class="card">
                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>" loading="lazy">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price"><span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS</div>
                                <div class="cantidad-selector">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>', <%= producto.precio %>)">AÑADIR</button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <% if (packs.length > 0) { %>
                <div class="categoria-titulo">📦 Packs</div>
                <div class="productos-container">
                    <% packs.forEach(producto => { %>
                        <div class="card">
                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>" loading="lazy">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price"><span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS</div>
                                <div class="cantidad-selector">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>', <%= producto.precio %>)">AÑADIR</button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <% if (prods.length > 0) { %>
                <div class="categoria-titulo">✨ Productos</div>
                <div class="productos-container">
                    <% prods.forEach(producto => { %>
                        <div class="card">
                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>" loading="lazy">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price"><span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS</div>
                                <div class="cantidad-selector">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>', <%= producto.precio %>)">AÑADIR</button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- VISTA: SCOOPS -->
        <div id="vista-scoops" style="display: none; width: 100%;">
            <div class="productos-container">
                <% scoops.forEach(producto => { %>
                    <div class="card">
                        <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                        <div class="card-info">
                            <h3><%= producto.titulo %></h3>
                            <div class="price"><span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS</div>
                            <div class="cantidad-selector">
                                <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                            </div>
                            <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>', <%= producto.precio %>)">AÑADIR</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- VISTA: PRODUCTOS -->
        <div id="vista-productos" style="display: none; width: 100%;">
            <div class="productos-container">
                <% prods.forEach(producto => { %>
                    <div class="card">
                        <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                        <div class="card-info">
                            <h3><%= producto.titulo %></h3>
                            <div class="price"><span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS</div>
                            <div class="cantidad-selector">
                                <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                            </div>
                            <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>', <%= producto.precio %>)">AÑADIR</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- VISTA: PACKS -->
        <div id="vista-packs" style="display: none; width: 100%;">
            <div class="productos-container">
                <% packs.forEach(producto => { %>
                    <div class="card">
                        <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                        <div class="card-info">
                            <h3><%= producto.titulo %></h3>
                            <div class="price"><span id="precio-<%= producto.id %>"><%= producto.precio %></span> BS</div>
                            <div class="cantidad-selector">
                                <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                            </div>
                            <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>', <%= producto.precio %>)">AÑADIR</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>
</main>

<!-- MODAL CARRITO -->
<div class="modal-overlay" id="modal-carrito">
    <div class="modal-content">
        <button class="close-modal" onclick="cerrarCarrito()">✕</button>
        
        <!-- PASO 1: CARRITO -->
        <div id="paso-1">
            <h2 style="color: var(--piko-pink); text-align: center; font-weight: 800; margin-bottom: 20px;">Tu Carrito ✨</h2>
            <div id="lista-carrito" style="max-height: 300px; overflow-y: auto; margin-bottom: 20px;"></div>
            <div style="border-top: 2px dashed #f0f0f0; padding-top: 20px;">
                <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 1.3rem; color: var(--piko-dark); margin-bottom: 15px;">
                    <span>TOTAL</span>
                    <span><span id="total-modal">0.00</span> BS</span>
                </div>
                <button class="btn-add" style="width:100%;" onclick="irAPaso2()">CONTINUAR AL ENVÍO</button>
            </div>
        </div>

        <!-- PASO 2: DATOS DE ENVÍO -->
        <div id="paso-2" style="display: none;">
            <button onclick="irAPaso1()" style="background:none; border:none; color: #aaa; margin-bottom: 15px; cursor:pointer; font-weight: 600;">← Volver al carrito</button>
            <h2 style="text-align: center; color: var(--piko-pink); font-weight: 800; margin-bottom: 15px;">Datos de Envío</h2>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <input type="text" id="f-nombre" placeholder="Nombre completo" class="piko-input">
                <input type="tel" id="f-celular" placeholder="WhatsApp (ej. 77123456)" class="piko-input">
                
                <select id="f-ciudad" class="piko-input" onchange="gestionarTransportadora()">
                    <option value="">-- Selecciona ciudad --</option>
                    <option value="Sucre">Sucre (Chuquisaca)</option>
                    <option value="La Paz">La Paz</option>
                    <option value="El Alto">El Alto (La Paz)</option>
                    <option value="Oruro">Oruro</option>
                    <option value="Potosí">Potosí</option>
                    <option value="Villazon">Villazon (Potosí)</option>
                    <option value="Tupiza">Tupiza (Potosí)</option>
                    <option value="Uyuni">Uyuni (Potosí)</option>
                    <option value="Cochabamba">Cochabamba</option>
                    <option value="Quillacollo">Quillacollo (Cochabamba)</option>
                    <option value="Tarija">Tarija</option>
                    <option value="Yotala">Yotala (Chuquisaca)</option>
                    <option value="Beremejo">Beremejo (Tarija)</option>
                    <option value="Camargo">Camargo (Tarija)</option>
                    <option value="Santa Cruz">Santa Cruz</option>
                    <option value="Beni">Beni</option>
                    <option value="Pando">Pando</option>
                    <option value="Otra">Otra ciudad (escribir)</option>
                </select>

                <input type="text" id="otra-ciudad" placeholder="Especifica tu ciudad" class="piko-input hidden">

                <!-- SUCRE: RECOJO O DELIVERY -->
                <div id="opciones-sucre" class="hidden">
                    <label style="font-size: 0.9rem; font-weight: 600; color: #666; display: block; margin-bottom: 8px;">¿Cómo recibirás? 📦</label>
                    <select id="recojo-sucre" class="piko-input">
                        <option value="Zona Cementerio">Recojo - Zona Cementerio</option>
                        <option value="Plaza 25 de Mayo">Recojo - Plaza 25 de Mayo</option>
                        <option value="Correos">Recojo - Correos</option>
                        <option value="Delivery Sucre">Delivery a domicilio (+10 BS)</option>
                    </select>
                </div>

                <!-- OTRAS CIUDADES: TRANSPORTADORA -->
                <div id="opciones-transportadora" class="hidden">
                    <label style="font-size: 0.9rem; font-weight: 600; color: #666; display: block; margin-bottom: 8px;">Transportadora 🚚</label>
                    <select id="f-transportadora" class="piko-input" onchange="mostrarCampoTransportadora()">
                        <option value="">-- Selecciona transportadora --</option>
                        <option value="Amazon Express">Amazon Express (Capitales)</option>
                        <option value="Rapiditos del Sur">Rapiditos del Sur (Potosí, Tarija)</option>
                        <option value="San Miguel">San Miguel (Oruro)</option>
                        <option value="El Mexicano">El Mexicano (Tarija, El Alto, La Paz, Santa Cruz, Camargo)</option>
                        <option value="Bolivar">Bolívar (Cochabamba, Quillacollo, La Paz)</option>
                        <option value="El Dorado">El Dorado (Capitales + El Alto, Quillacollo)</option>
                        <option value="Bustillos">Bustillos (Oruro)</option>
                        <option value="Quirquincho">Quirquincho (Cochabamba, La Paz, Quillacollo)</option>
                        <option value="Copacabana">Copacabana (Capitales + El Alto, Quillacollo)</option>
                        <option value="Otra">Otra transportadora (escribir)</option>
                    </select>

                    <!-- Nombre custom de transportadora -->
                    <input type="text" id="f-otra-transportadora" placeholder="Nombre de la transportadora" class="piko-input hidden" style="margin-top: 8px;">

                    <!-- SUCURSAL: Terminal u Otra -->
                    <div id="bloque-sucursal" class="hidden" style="margin-top: 8px;">
                        <label style="font-size: 0.85rem; font-weight: 600; color: #666; display: block; margin-bottom: 6px;">Sucursal / Zona 📍</label>
                        <select id="f-tipo-sucursal" class="piko-input" onchange="gestionarSucursal()">
                            <option value="Terminal">Terminal</option>
                            <option value="Otra">Otra (escribir)</option>
                        </select>
                        <input type="text" id="f-sucursal-custom" placeholder="Escribe la sucursal o zona" class="piko-input hidden" style="margin-top: 8px;">
                    </div>
                </div>

                <!-- RESUMEN TOTAL -->
                <div style="margin-top: 15px; background: var(--piko-pastel); padding: 15px; border-radius: 10px;">
                    <div style="display: flex; justify-content: space-between; font-weight: 800; color: var(--piko-pink); font-size: 1.1rem;">
                        <span>Total a pagar:</span>
                        <span><span id="total-final">0.00</span> BS</span>
                    </div>
                </div>

                <button type="button" id="btn-piko-final" class="btn-add" style="width: 100%; padding: 12px; font-weight: 700;" onclick="enviarPedido()">CONFIRMAR PEDIDO</button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
let carrito = JSON.parse(localStorage.getItem('piko_cart')) || [];

const transportadorasPorCiudad = {
    'La Paz': ['Amazon Express', 'El Mexicano', 'Bolivar', 'El Dorado', 'Quirquincho', 'Copacabana', 'Otra'],
    'El Alto': ['Amazon Express', 'El Mexicano', 'El Dorado', 'Quirquincho', 'Copacabana', 'Otra'],
    'Oruro': ['San Miguel', 'Bustillos', 'Amazon Express', 'Otra'],
    'Potosí': ['Rapiditos del Sur', 'Amazon Express', 'Otra'],
    'Villazon': ['Rapiditos del Sur', 'Otra'],
    'Tupiza': ['Rapiditos del Sur', 'Otra'],
    'Uyuni': ['Rapiditos del Sur', 'Otra'],
    'Cochabamba': ['Bolivar', 'El Dorado', 'Quirquincho', 'Copacabana', 'Amazon Express', 'Otra'],
    'Quillacollo': ['Bolivar', 'El Dorado', 'Quirquincho', 'Copacabana', 'Amazon Express', 'Otra'],
    'Tarija': ['Rapiditos del Sur', 'El Mexicano', 'Amazon Express', 'Otra'],
    'Beremejo': ['Rapiditos del Sur', 'El Mexicano', 'Otra'],
    'Camargo': ['El Mexicano', 'Rapiditos del Sur', 'Otra'],
    'Santa Cruz': ['Amazon Express', 'El Mexicano', 'El Dorado', 'Copacabana', 'Otra'],
    'Beni': ['Amazon Express', 'Otra'],
    'Pando': ['Amazon Express', 'Otra'],
    'Yotala': ['Amazon Express', 'Rapiditos del Sur', 'Otra']
};

document.addEventListener('DOMContentLoaded', actualizarUI);

function guardarCarrito() { localStorage.setItem('piko_cart', JSON.stringify(carrito)); }

function sumarCantidad(id) { 
    const inp = document.getElementById(`cant-${id}`);
    inp.value = parseInt(inp.value) + 1;
}

function restarCantidad(id) { 
    const inp = document.getElementById(`cant-${id}`);
    if(parseInt(inp.value) > 1) inp.value = parseInt(inp.value) - 1;
}

// Cambiar cantidad directamente desde el carrito
function cambiarCantidadCarrito(idx, delta) {
    carrito[idx].cantidad += delta;
    if(carrito[idx].cantidad < 1) carrito[idx].cantidad = 1;
    actualizarUI();
}

function agregarAlCarrito(id, titulo, img, precio) {
    const cantidad = parseInt(document.getElementById(`cant-${id}`).value);
    const existe = carrito.find(p => p.id === id);
    
    if(existe) existe.cantidad += cantidad;
    else carrito.push({ id, titulo, img, precio, cantidad });
    
    document.getElementById(`cant-${id}`).value = 1;
    
    Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 }).fire({
        icon: 'success', title: `¡${titulo} añadido! ✨`
    });
    
    actualizarUI();
}

function actualizarUI() {
    let total = 0, unidades = 0;
    const lista = document.getElementById('lista-carrito');
    
    lista.innerHTML = carrito.map((p, idx) => {
        const sub = p.precio * p.cantidad;
        total += sub;
        unidades += p.cantidad;
        return `
            <div class="carrito-item">
                <img src="${p.img}" alt="${p.titulo}">
                <div class="carrito-item-info">
                    <div class="carrito-item-nombre">${p.titulo}</div>
                    <div class="carrito-item-precio">${sub.toFixed(2)} BS</div>
                </div>
                <div class="carrito-item-controles">
                    <button onclick="cambiarCantidadCarrito(${idx}, -1)">−</button>
                    <span>${p.cantidad}</span>
                    <button onclick="cambiarCantidadCarrito(${idx}, 1)">+</button>
                </div>
                <button class="carrito-item-borrar" onclick="carrito.splice(${idx}, 1); actualizarUI();">×</button>
            </div>`;
    }).join('');
    
    if(carrito.length === 0) {
        lista.innerHTML = "<div style='text-align:center; color:#bbb; padding:30px;'>Tu carrito está vacío 🌸</div>";
    }
    
    document.getElementById('nav-total-bs').innerText = total.toFixed(2);
    document.getElementById('total-modal').innerText = total.toFixed(2);
    document.getElementById('total-final').innerText = total.toFixed(2);
    document.getElementById('cart-count-badge').innerText = unidades;
    
    guardarCarrito();
}

function gestionarTransportadora() {
    const ciudad = document.getElementById('f-ciudad').value;
    
    document.getElementById('otra-ciudad').classList.toggle('hidden', ciudad !== 'Otra');
    document.getElementById('opciones-sucre').classList.toggle('hidden', ciudad !== 'Sucre');
    document.getElementById('opciones-transportadora').classList.toggle('hidden', ciudad === 'Sucre' || !ciudad || ciudad === 'Otra');
    
    // Resetear sucursal al cambiar ciudad
    document.getElementById('bloque-sucursal').classList.add('hidden');
    document.getElementById('f-sucursal-custom').classList.add('hidden');
    
    if(ciudad && ciudad !== 'Sucre' && ciudad !== 'Otra') {
        const transSelect = document.getElementById('f-transportadora');
        const opcionesDisponibles = transportadorasPorCiudad[ciudad] || ['Otra'];
        
        transSelect.innerHTML = '<option value="">-- Selecciona transportadora --</option>';
        opcionesDisponibles.forEach(trans => {
            const opt = document.createElement('option');
            opt.value = trans;
            opt.textContent = trans;
            transSelect.appendChild(opt);
        });
    }
}

function mostrarCampoTransportadora() {
    const trans = document.getElementById('f-transportadora').value;
    // Nombre custom si elige "Otra"
    document.getElementById('f-otra-transportadora').classList.toggle('hidden', trans !== 'Otra');
    // Bloque de sucursal: mostrar si eligió alguna transportadora (que no sea vacío ni "Otra")
    const mostrarSucursal = trans !== '' && trans !== 'Otra';
    document.getElementById('bloque-sucursal').classList.toggle('hidden', !mostrarSucursal);
    // Resetear campo custom de sucursal
    if(!mostrarSucursal) {
        document.getElementById('f-tipo-sucursal').value = 'Terminal';
        document.getElementById('f-sucursal-custom').classList.add('hidden');
    }
}

function gestionarSucursal() {
    const tipo = document.getElementById('f-tipo-sucursal').value;
    document.getElementById('f-sucursal-custom').classList.toggle('hidden', tipo !== 'Otra');
}

async function enviarPedido() {
    const nombre = document.getElementById('f-nombre').value.trim();
    const celular = document.getElementById('f-celular').value.trim();
    let ciudad = document.getElementById('f-ciudad').value;
    const otraCiudad = document.getElementById('otra-ciudad').value.trim();
    
    if(ciudad === 'Otra') ciudad = otraCiudad;
    
    if(!nombre || !celular || !ciudad || carrito.length === 0) {
        return Swal.fire("¡Ups!", "Completa todos los datos.", "warning");
    }

    let infoEnvio = '';
    if(ciudad === 'Sucre') {
        infoEnvio = document.getElementById('recojo-sucre').value;
    } else {
        const trans = document.getElementById('f-transportadora').value;
        const otraTrans = document.getElementById('f-otra-transportadora').value.trim();
        const nombreTrans = trans === 'Otra' ? otraTrans : trans;

        // Obtener sucursal
        let sucursal = '';
        if(trans && trans !== 'Otra') {
            const tipoSucursal = document.getElementById('f-tipo-sucursal').value;
            if(tipoSucursal === 'Otra') {
                sucursal = document.getElementById('f-sucursal-custom').value.trim();
            } else {
                sucursal = 'Terminal';
            }
        }

        infoEnvio = `${nombreTrans}${sucursal ? ' - ' + sucursal : ''}`;
    }

    const total = document.getElementById('total-final').innerText;

    // Número de pedido con formato 0001, 0002, etc.
    let contadorActual = parseInt(localStorage.getItem('piko_contador') || '0') + 1;
    localStorage.setItem('piko_contador', contadorActual);
    const nroPedido = String(contadorActual).padStart(4, '0');

    const btn = document.getElementById('btn-piko-final');
    btn.disabled = true;
    btn.innerText = "PROCESANDO...";

    try {
        const response = await fetch('/confirmar-pedido', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ 
                nombre, celular, ciudad, total, carrito, nro: nroPedido, envio: infoEnvio
            })
        });

        if(response.ok) {
            const blob = await response.blob();
            const pdfUrl = window.URL.createObjectURL(blob);

            // Descargar automáticamente
            const a = document.createElement('a');
            a.href = pdfUrl;
            a.download = `Recibo_${nroPedido}.pdf`;
            a.click();

            // Guardar items para el mensaje de WhatsApp antes de limpiar
            localStorage.setItem('piko_last_items', JSON.stringify(carrito));

            // Limpiar carrito
            carrito = [];
            actualizarUI();
            irAPaso1();
            cerrarCarrito();

            // Armar mensaje de WhatsApp
            const itemsTexto = JSON.parse(localStorage.getItem('piko_last_items') || '[]')
                .map(p => `• ${p.titulo} x${p.cantidad}`).join('%0A') || '';
            const mensajeWA = encodeURIComponent(
                `¡Hola! 🌸 Soy *${nombre}*\n` +
                `Pedido N° *${nroPedido}*\n` +
                `Ciudad: ${ciudad} | Envío: ${infoEnvio}\n` +
                `Total: *${total} BS*\n` 
            );
            const waUrl = `https://wa.me/59164723077?text=${mensajeWA}`;

            // SweetAlert con dos botones
            Swal.fire({
                title: '¡Pedido listo! 🎉',
                html: `
                    <p style="color:#666; margin-bottom:18px;">Tu recibo <strong>#${nroPedido}</strong> ya se descargó.<br>Envíalo por WhatsApp para confirmar tu pedido.</p>
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <a href="${waUrl}" target="_blank"
                           style="display:block; background:#25D366; color:white; padding:12px 20px; border-radius:10px; font-weight:700; font-family:Poppins; text-decoration:none; font-size:0.95rem;">
                           📲 Enviar por WhatsApp
                        </a>
                        <button onclick="reDescargarRecibo('${pdfUrl}','${nroPedido}')"
                            style="background:#ff85a2; color:white; border:none; padding:12px 20px; border-radius:10px; font-weight:700; font-family:Poppins; cursor:pointer; font-size:0.95rem;">
                            ⬇️ Volver a descargar recibo
                        </button>
                    </div>
                `,
                showConfirmButton: false,
                showCloseButton: true,
                customClass: { popup: 'swal-piko' }
            });
        }
    } catch(e) {
        Swal.fire("Error", "No pudimos procesar el pedido.", "error");
    } finally {
        btn.disabled = false;
        btn.innerText = "CONFIRMAR PEDIDO";
    }
}

function reDescargarRecibo(url, nro) {
    const a = document.createElement('a');
    a.href = url;
    a.download = `Recibo_${nro}.pdf`;
    a.click();
}

function filtrar(cat, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('[id^="vista-"]').forEach(v => v.style.display = 'none');
    document.getElementById(`vista-${cat}`).style.display = 'block';
}

function abrirCarrito() { document.getElementById('modal-carrito').classList.add('active'); }
function cerrarCarrito() { document.getElementById('modal-carrito').classList.remove('active'); }
function irAPaso2() { 
    if(carrito.length === 0) return Swal.fire("Vacío", "Añade productos primero.", "info");
    document.getElementById('paso-1').style.display = 'none'; 
    document.getElementById('paso-2').style.display = 'block'; 
}
function irAPaso1() { 
    document.getElementById('paso-2').style.display = 'none'; 
    document.getElementById('paso-1').style.display = 'block'; 
}
</script>

</body>
</html>
