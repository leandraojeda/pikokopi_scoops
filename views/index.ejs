<!-- MODAL CARRITO -->
<div class="modal-overlay" id="modal-carrito">
    <div class="modal-content">
        <button class="close-modal" onclick="cerrarCarrito()">✕</button>
        
        <div id="paso-1">
            <h2 style="color: var(--piko-pink); text-align: center; font-weight: 800; margin-bottom: 15px;">Tu Carrito ✨</h2>
            <div id="lista-carrito" style="max-height: 300px; overflow-y: auto; margin-bottom: 20px;"></div>
            <div style="border-top: 1px solid #eee; padding-top: 15px;">
                <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 1.2rem; color: var(--piko-dark); margin-bottom: 15px;">
                    <span>TOTAL</span>
                    <span><span id="total-modal">0</span> BS</span>
                </div>
                <button class="btn-add" style="width:100%; padding: 12px; font-size: 0.85rem;" onclick="irAPaso2()">CONTINUAR AL ENVÍO</button>
            </div>
        </div>

        <div id="paso-2" style="display: none;">
            <button onclick="irAPaso1()" style="background:none; border:none; cursor:pointer; color: #999; margin-bottom: 15px; font-weight: 600;"><i class="fa-solid fa-arrow-left"></i> Volver</button>
            <h2 style="text-align: center; margin-bottom: 15px; color: var(--piko-pink); font-weight: 800;">Datos de Envío</h2>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <input type="text" id="f-nombre" style="padding: 10px; border-radius: 8px; border: 1px solid #ddd; font-family: 'Poppins';" placeholder="Nombre completo">
                <input type="tel" id="f-celular" style="padding: 10px; border-radius: 8px; border: 1px solid #ddd; font-family: 'Poppins';" placeholder="WhatsApp">
                
                <select id="f-ciudad" style="padding: 10px; border-radius: 8px; border: 1px solid #ddd; font-family: 'Poppins';">
                    <option value="Sucre">Sucre</option>
                    <option value="La Paz">La Paz</option>
                    <option value="Santa Cruz">Santa Cruz</option>
                    <option value="Cochabamba">Cochabamba</option>
                </select>

                <div style="margin-top: 10px; background: var(--piko-pastel); padding: 15px; border-radius: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 600; color: #666;">Total a pagar:</span>
                        <span style="font-weight: 800; color: var(--piko-pink); font-size: 1.3rem;"><span id="total-final">0</span> BS</span>
                    </div>
                </div>
                <button type="button" id="btn-piko-final" class="btn-add" style="width: 100%; padding: 12px; font-size: 0.85rem;" onclick="enviarAlExcel()">
                    CONFIRMAR PEDIDO
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    let carrito = [];
    let total = 0;

    function sumarCantidad(id) {
        const input = document.getElementById(`cant-${id}`);
        input.value = parseInt(input.value) + 1;
    }

    function restarCantidad(id) {
        const input = document.getElementById(`cant-${id}`);
        if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
        }
    }

    function agregarAlCarrito(id, titulo, img) {
        const precio = parseFloat(document.getElementById(`precio-${id}`).innerText);
        const cantidad = parseInt(document.getElementById(`cant-${id}`).value) || 1;
        const sel = document.getElementById(`select-${id}`);
        const variante = sel ? sel.options[sel.selectedIndex].getAttribute('data-nombre') : "";
        
        carrito.push({ idU: Date.now(), titulo, img, variante, precio, cantidad, subtotal: precio * cantidad });
        total += (precio * cantidad);
        actualizarUI();
    }

    function actualizarUI() {
        document.getElementById('nav-total-bs').innerText = total.toFixed(2);
        document.getElementById('total-modal').innerText = total.toFixed(2);
        const unidades = carrito.reduce((sum, p) => sum + p.cantidad, 0);
        const badge = document.getElementById('cart-count-badge');
        badge.innerText = unidades;
        badge.classList.toggle('visible', unidades > 0);
        
        const lista = document.getElementById('lista-carrito');
        lista.innerHTML = carrito.map((p, idx) => `
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px; border-bottom:1px solid #f0f0f0; padding-bottom:10px;">
                <img src="${p.img}" style="width:45px; height:45px; border-radius:8px; object-fit:cover;">
                <div style="flex:1">
                    <div style="font-weight:600; font-size:0.85rem;">${p.titulo}</div>
                    <small style="color:#999">${p.variante}</small>
                </div>
                <div style="font-weight:800; color:var(--piko-pink); font-size:0.9rem;">${p.subtotal.toFixed(2)}</div>
                <button onclick="eliminarDelCarrito(${idx})" style="background:none; border:none; color:#ccc; cursor:pointer; font-size:1rem;">×</button>
            </div>
        `).join('');
    }

    function eliminarDelCarrito(idx) {
        total -= carrito[idx].subtotal;
        carrito.splice(idx, 1);
        actualizarUI();
    }

    async function enviarAlExcel() {
        const btn = document.getElementById('btn-piko-final');
        const nombre = document.getElementById('f-nombre').value;
        const celular = document.getElementById('f-celular').value;
        const ciudad = document.getElementById('f-ciudad').value;

        if(!nombre || !celular) return Swal.fire("¡Ups!", "Completa tus datos", "warning");

        let nro = (parseInt(localStorage.getItem('piko_nro') || "0") + 1).toString().padStart(4, '0');
        localStorage.setItem('piko_nro', nro);

        btn.disabled = true;
        btn.innerText = "PROCESANDO...";

        try {
            const res = await fetch('/confirmar-pedido', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ nombre, celular, ciudad, total: total.toFixed(2), carrito, nro })
            });

            if (res.ok) {
                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url; 
                a.download = `Recibo_#${nro}_${nombre}.pdf`;
                a.click();

                cerrarCarrito();
                carrito = [];
                total = 0;
                actualizarUI();

                const msg = encodeURIComponent(`Pedido #${nro} - ${nombre}`);
                
                Swal.fire({
                    title: 'PEDIDO LISTO!',
                    html: `<p style="font-size: 1.2rem; font-weight:800; color: var(--piko-pink);">#${nro}</p><p>Tu recibo se descargó. ¡Envíalo por WhatsApp!</p>`,
                    showConfirmButton: false,
                    footer: '<a href="javascript:location.reload()" style="color:#999;">Nuevo pedido</a>'
                });
            }
        } catch (e) {
            Swal.fire("Error", "No pudimos procesar", "error");
        } finally {
            btn.disabled = false;
            btn.innerText = "CONFIRMAR PEDIDO";
        }
    }

    function irAPaso2() { 
        document.getElementById('paso-1').style.display = 'none'; 
        document.getElementById('paso-2').style.display = 'block'; 
        document.getElementById('total-final').innerText = total.toFixed(2); 
    }
    function irAPaso1() { 
        document.getElementById('paso-2').style.display = 'none'; 
        document.getElementById('paso-1').style.display = 'block'; 
    }
    function abrirCarrito() { 
        document.getElementById('modal-carrito').classList.add('active'); 
    }
    function cerrarCarrito() { 
        document.getElementById('modal-carrito').classList.remove('active'); 
    }
    function filtrar(cat, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        document.getElementById('vista-todos').style.display = 'none';
        document.getElementById('vista-scoops').style.display = 'none';
        document.getElementById('vista-productos-cat').style.display = 'none';
        document.getElementById('vista-packs').style.display = 'none';
        
        if (cat === 'todos') {
            document.getElementById('vista-todos').style.display = 'block';
        } else if (cat === 'scoops') {
            document.getElementById('vista-scoops').style.display = 'block';
        } else if (cat === 'productos') {
            document.getElementById('vista-productos-cat').style.display = 'block';
        } else if (cat === 'packs') {
            document.getElementById('vista-packs').style.display = 'block';
        }
    }
</script>
</body>
</html>