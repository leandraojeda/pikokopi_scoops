function gestionarTransportadora() {
    const ciudad = document.getElementById('f-ciudad').value;
    document.getElementById('otra-ciudad').classList.toggle('hidden', ciudad !== 'Otra');
    document.getElementById('opciones-sucre').classList.toggle('hidden', ciudad !== 'Sucre');
    document.getElementById('opciones-transportadora').classList.toggle('hidden', ciudad === 'Sucre' || !ciudad || ciudad === 'Otra');
    document.getElementById('bloque-sucursal').classList.add('hidden');
    document.getElementById('bloque-pago-envio').classList.add('hidden');
    document.getElementById('f-sucursal-custom').classList.add('hidden');

    if (ciudad && ciudad !== 'Sucre' && ciudad !== 'Otra') {
        const transSelect = document.getElementById('f-transportadora');
        const opciones = transportadorasPorCiudad[ciudad] || ['Otra'];
        transSelect.innerHTML = '<option value="">-- Selecciona transportadora --</option>';
        opciones.forEach(t => { const o = document.createElement('option'); o.value = t; o.textContent = t; transSelect.appendChild(o); });
    }
}

function mostrarCampoTransportadora() {
    const trans = document.getElementById('f-transportadora').value;
    document.getElementById('f-otra-transportadora').classList.toggle('hidden', trans !== 'Otra');
    const mostrar = trans !== '' && trans !== 'Otra';
    document.getElementById('bloque-sucursal').classList.toggle('hidden', !mostrar);
    document.getElementById('bloque-pago-envio').classList.toggle('hidden', !mostrar);
    if (!mostrar) {
        document.getElementById('f-tipo-sucursal').value = 'Terminal';
        document.getElementById('f-sucursal-custom').classList.add('hidden');
    }
}

function gestionarSucursal() {
    const tipo = document.getElementById('f-tipo-sucursal').value;
    document.getElementById('f-sucursal-custom').classList.toggle('hidden', tipo !== 'Otra');
}

// ── ENVIAR PEDIDO ──────────────────────────────────────────────────────────────
async function enviarPedido() {
    const nombre = document.getElementById('f-nombre').value.trim();
    const celular = document.getElementById('f-celular').value.trim();
    let ciudad = document.getElementById('f-ciudad').value;
    const otraCiudad = document.getElementById('otra-ciudad').value.trim();
    if (ciudad === 'Otra') ciudad = otraCiudad;

    if (!nombre || !celular || !ciudad || carrito.length === 0) {
        return Swal.fire('¡Ups!', 'Completa todos los datos.', 'warning');
    }

    let infoEnvio = '';
    let infoPagoEnvio = '';
    if (ciudad === 'Sucre') {
        infoEnvio = document.getElementById('recojo-sucre').value;
    } else {
        const trans = document.getElementById('f-transportadora').value;
        const otraTrans = document.getElementById('f-otra-transportadora').value.trim();
        const nombreTrans = trans === 'Otra' ? otraTrans : trans;
        let sucursal = '';
        if (trans && trans !== 'Otra') {
            const tipoSucursal = document.getElementById('f-tipo-sucursal').value;
            sucursal = tipoSucursal === 'Otra'
                ? document.getElementById('f-sucursal-custom').value.trim()
                : 'Terminal';
            infoPagoEnvio = pagoEnvioSeleccionado === 'pagando' ? 'Pagando aquí' : 'Por pagar allá';
        }
        infoEnvio = nombreTrans + (sucursal ? ' - ' + sucursal : '');
    }

    const subtotal = carrito.reduce((acc, p) => acc + p.precio * p.cantidad, 0);
    const descMonto = descuentoAplicado ? descuentoAplicado.monto : 0;
    const totalFinal = Math.max(0, subtotal - descMonto).toFixed(2);
    const codigoUsado = descuentoAplicado ? descuentoAplicado.codigo : '';

    const btn = document.getElementById('btn-piko-final');
    btn.disabled = true; btn.innerText = 'PROCESANDO...';

    try {
        // Obtener número único del servidor
        let nroPedido;
        try {
            const nroResp = await fetch('/nuevo-numero');
            if (!nroResp.ok) throw new Error('HTTP ' + nroResp.status);
            const nroData = await nroResp.json();
            if (!nroData.nro || nroData.nro === 'undefined') throw new Error('nro invalido');
            nroPedido = nroData.nro;
        } catch (nroErr) {
            btn.disabled = false; btn.innerText = 'CONFIRMAR PEDIDO';
            return Swal.fire('Error', 'No se pudo generar el número de pedido. Intenta de nuevo.', 'error');
        }

        const response = await fetch('/confirmar-pedido', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                nombre, celular, ciudad, total: totalFinal, carrito,
                nro: nroPedido, envio: infoEnvio, pagoEnvio: infoPagoEnvio,
                descuento: codigoUsado, descuentoMonto: descMonto.toFixed(2),
                subtotal: subtotal.toFixed(2)
            })
        });

        if (response.ok) {
            const blob = await response.blob();
            const pdfUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = pdfUrl; a.download = 'Recibo_'+nroPedido+'.pdf'; a.click();

            localStorage.setItem('piko_last_items', JSON.stringify(carrito));
            carrito = [];
            descuentoAplicado = null;
            quitarDescuento();
            actualizarUI();
            irAPaso1();
            cerrarCarrito();

            const mensajeWA = encodeURIComponent(
                '¡Hola! 🌸 Soy *'+nombre+'*\n' +
                'Pedido N° *'+nroPedido+'*\n' +
                'Ciudad: '+ciudad+' | Envío: '+infoEnvio+(infoPagoEnvio ? ' ('+infoPagoEnvio+')' : '')+'\n' +
                (codigoUsado ? 'Descuento: '+codigoUsado+' (−'+descMonto.toFixed(2)+' BS)\n' : '') +
                'Total productos: *'+totalFinal+' BS*\n' +
                '¡Ya envié mi recibo! 🛍️'
            );
            const waUrl = 'https://wa.me/59177143374?text='+mensajeWA;

            Swal.fire({
                title: '¡Pedido listo! 🎉',
                html:
                    '<p style="color:#666;margin-bottom:18px;">Tu recibo <strong>#'+nroPedido+'</strong> ya se descargó.<br>Envíalo por WhatsApp para confirmar.</p>' +
                    '<div style="display:flex;flex-direction:column;gap:10px;">' +
                        '<a href="'+waUrl+'" target="_blank" style="display:block;background:#25D366;color:white;padding:12px 20px;border-radius:10px;font-weight:700;font-family:Poppins;text-decoration:none;font-size:0.95rem;">📲 Enviar por WhatsApp</a>' +
                        '<button onclick="reDescargarRecibo(\''+pdfUrl+'\',\''+nroPedido+'\')" style="background:#ff85a2;color:white;border:none;padding:12px 20px;border-radius:10px;font-weight:700;font-family:Poppins;cursor:pointer;font-size:0.95rem;">⬇️ Volver a descargar recibo</button>' +
                    '</div>',
                showConfirmButton: false, showCloseButton: true
            });
        } else {
            Swal.fire('Error', 'No pudimos procesar el pedido. Código: '+response.status, 'error');
        }
    } catch(e) {
        console.error(e);
        Swal.fire('Error', 'No pudimos procesar el pedido.', 'error');
    } finally {
        btn.disabled = false; btn.innerText = 'CONFIRMAR PEDIDO';
    }
}

function reDescargarRecibo(url, nro) { const a = document.createElement('a'); a.href=url; a.download='Recibo_'+nro+'.pdf'; a.click(); }

function filtrar(cat, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('[id^="vista-"]').forEach(v => v.style.display = 'none');
    document.getElementById('vista-'+cat).style.display = 'block';
}

function abrirCarrito()  { document.getElementById('modal-carrito').classList.add('active'); }
function cerrarCarrito() { document.getElementById('modal-carrito').classList.remove('active'); }
function irAPaso2() {
    if (carrito.length === 0) return Swal.fire('Vacío','Añade productos primero.','info');
    document.getElementById('paso-1').style.display = 'none';
    document.getElementById('paso-2').style.display = 'block';
}
function irAPaso1() {
    document.getElementById('paso-2').style.display = 'none';
    document.getElementById('paso-1').style.display = 'block';
}
</script>
