                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price" id="precio-<%= producto.id %>">
                                    <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                                </div>
                                <% if (producto.variantes && producto.variantes.length > 0) { %>
                                    <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                                        <% producto.variantes.forEach(v => { %>
                                            <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                                        <% }) %>
                                    </select>
                                <% } %>
                                
                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                                    <div class="cantidad-selector">
                                        <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                        <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                        <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                    </div>
                                    <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <% if (prods.length > 0) { %>
                <div class="categoria-titulo">✨ Productos</div>
                <div class="productos-container">
                    <% prods.forEach(producto => { %>
                        <div class="card item-producto" data-categoria="<%= producto.cat %>">
                            <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                            <div class="card-info">
                                <h3><%= producto.titulo %></h3>
                                <div class="price" id="precio-<%= producto.id %>">
                                    <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                                </div>
                                <% if (producto.variantes && producto.variantes.length > 0) { %>
                                    <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                                        <% producto.variantes.forEach(v => { %>
                                            <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                                        <% }) %>
                                    </select>
                                <% } %>
                                
                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                                    <div class="cantidad-selector">
                                        <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                        <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                        <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                    </div>
                                    <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- VISTA: SCOOPS -->
        <div id="vista-scoops" class="vista-productos" style="display: none; grid-column: 1 / -1;">
            <div class="productos-container">
                <% scoops.forEach(producto => { %>
                    <div class="card item-producto" data-categoria="<%= producto.cat %>">
                        <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                        <div class="card-info">
                            <h3><%= producto.titulo %></h3>
                            <div class="price" id="precio-<%= producto.id %>">
                                <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                            </div>
                            <% if (producto.variantes && producto.variantes.length > 0) { %>
                                <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                                    <% producto.variantes.forEach(v => { %>
                                        <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                                    <% }) %>
                                </select>
                            <% } %>
                            
                            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                                <div class="cantidad-selector">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- VISTA: PRODUCTOS -->
        <div id="vista-productos-cat" class="vista-productos" style="display: none; grid-column: 1 / -1;">
            <div class="productos-container">
                <% prods.forEach(producto => { %>
                    <div class="card item-producto" data-categoria="<%= producto.cat %>">
                        <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                        <div class="card-info">
                            <h3><%= producto.titulo %></h3>
                            <div class="price" id="precio-<%= producto.id %>">
                                <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                            </div>
                            <% if (producto.variantes && producto.variantes.length > 0) { %>
                                <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                                    <% producto.variantes.forEach(v => { %>
                                        <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                                    <% }) %>
                                </select>
                            <% } %>
                            
                            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                                <div class="cantidad-selector">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- VISTA: PACKS -->
        <div id="vista-packs" class="vista-productos" style="display: none; grid-column: 1 / -1;">
            <div class="productos-container">
                <% packs.forEach(producto => { %>
                    <div class="card item-producto" data-categoria="<%= producto.cat %>">
                        <img src="<%= producto.img %>" alt="<%= producto.titulo %>">
                        <div class="card-info">
                            <h3><%= producto.titulo %></h3>
                            <div class="price" id="precio-<%= producto.id %>">
                                <%= producto.variantes && producto.variantes.length > 0 ? producto.variantes[0].precio : producto.precio %>
                            </div>
                            <% if (producto.variantes && producto.variantes.length > 0) { %>
                                <select class="select-tipo" id="select-<%= producto.id %>" onchange="document.getElementById('precio-<%= producto.id %>').innerText = this.value">
                                    <% producto.variantes.forEach(v => { %>
                                        <option value="<%= v.precio %>" data-nombre="<%= v.nombre %>"><%= v.nombre %></option>
                                    <% }) %>
                                </select>
                            <% } %>
                            
                            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                                <div class="cantidad-selector">
                                    <button class="cantidad-btn" onclick="restarCantidad('<%= producto.id %>')">−</button>
                                    <input type="number" id="cant-<%= producto.id %>" class="cantidad-input" value="1" min="1">
                                    <button class="cantidad-btn" onclick="sumarCantidad('<%= producto.id %>')">+</button>
                                </div>
                                <button class="btn-add" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR</button>
