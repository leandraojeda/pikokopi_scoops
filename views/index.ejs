                                    <button class="btn-add" style="flex: 1; margin-top: 0; margin-bottom: 0;" onclick="agregarAlCarrito('<%= producto.id %>', '<%= producto.titulo %>', '<%= producto.img %>')">AÑADIR 🛒</button>
