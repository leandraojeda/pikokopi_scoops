<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Piko Kopi Shop 🌸</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { --piko-pink: #ff85a2; --piko-pastel: #fff0f3; --piko-dark: #444; }
        body { padding-top: 0 !important; }
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
            display: none; justify-content: center; align-items: center; z-index: 2000;
        }
        .modal-overlay.active { display: flex; }
        .modal-content {
            background: white; width: 90%; max-width: 450px; padding: 25px;
            border-radius: 25px; position: relative;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            animation: slideUp 0.35s ease-out; max-height: 90vh; overflow-y: auto;
        }
        @keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .close-modal { position: absolute; top: 12px; right: 15px; background: none; border: none; font-size: 1.5rem; color: #999; cursor: pointer; }
        .piko-input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 10px; font-family: 'Poppins'; font-size: 0.9rem; transition: 0.3s; }
        .piko-input:focus { outline: none; border-color: var(--piko-pink); box-shadow: 0 0 8px rgba(255,133,162,0.2); }
        .hidden { display: none; }

        /* Código de descuento */
        .descuento-wrapper {
            display: flex; gap: 8px; align-items: stretch;
        }
        .descuento-wrapper input { flex: 1; text-transform: uppercase; letter-spacing: 1px; }
        .btn-aplicar-desc {
            padding: 0 14px; background: var(--piko-dark); color: white;
            border: none; border-radius: 10px; font-family: 'Poppins';
            font-weight: 700; font-size: 0.8rem; cursor: pointer; white-space: nowrap;
            transition: 0.3s;
        }
        .btn-aplicar-desc:hover { background: var(--piko-pink); }
        .desc-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: #e8f8ee; color: #2d7a4f; padding: 6px 12px;
            border-radius: 8px; font-size: 0.82rem; font-weight: 700;
        }
        .desc-badge button {
            background: none; border: none; color: #2d7a4f; cursor: pointer;
            font-size: 1rem; line-height: 1; padding: 0;
        }

        /* Selector pagando / por pagar */
        .pago-envio-selector {
            display: flex; gap: 8px;
        }
        .pago-envio-btn {
            flex: 1; padding: 10px 8px; border: 2px solid #e0e0e0;
            border-radius: 10px; background: white; font-family: 'Poppins';
            font-size: 0.8rem; font-weight: 600; color: #999; cursor: pointer;
            transition: 0.25s; text-align: center;
        }
        .pago-envio-btn.selected {
            border-color: var(--piko-pink); color: var(--piko-pink);
            background: var(--piko-pastel);
        }
    </style>
</head>
<body>

<%- include('partials/header') %>

<nav class="navbar" id="main-navbar">
    <div class="nav-left"><a href="/" class="logo">PIKO <span>KOPI</span></a></div>
    <div class="nav-center">
        <button class="filter-btn active" onclick="filtrar('todos', this)">TODOS</button>
        <button class="filter-btn" onclick="filtrar('scoops', this)">SCOOPS</button>
        <button class="filter-btn" onclick="filtrar('productos', this)">PRODUCTOS</button>
        <button class="filter-btn" onclick="filtrar('packs', this)">PACKS</button>
    </div>
    <div class="nav-right">
        <div class="header-total"><span id="nav-total-bs">0.00</span> BS</div>
        <div class="cart-wrapper" onclick="abrirCarrito()">
            <i class="fa-solid fa-cart-shopping"></i>
            <span id="cart-count-badge">0</span>
        </div>
    </div>
</nav>

<div id="banner-wrapper">
    <section class="banner-section">
        <picture>
            <source media="(min-width: 1024px)" srcset="/img/banner-pc.png">
            <source media="(min-width: 768px)" srcset="/img/banner-tab.png">
            <img src="/img/banner-cel.png" alt="Piko Kopi Banner Principal">
        </picture>
    </section>
</div>

<main id="main-container">
    <% if (typeof productos !== 'undefined' && productos.length > 0) { %>
        <%
            const scoops = productos.filter(p => p.cat === 'scoops');
            const packs  = productos.filter(p => p.cat === 'packs');
            const prods  = productos.filter(p => p.cat === 'productos');
        %>

        <!-- ── VISTA TODOS ──────────────────────────────────────────── -->
        <div id="vista-todos" style="width:100%;">
            <% if (scoops.length > 0) { %>
                <div class="categoria-titulo">🍦 Scoops</div>
                <div class="productos-container">
                    <% scoops.forEach(producto => { %>
                        <%- include('partials/card', { producto, prefix: '' }) %>
                    <% }) %>
                </div>
            <% } %>
            <% if (packs.length > 0) { %>
                <div class="categoria-titulo">📦 Packs</div>
                <div class="productos-container">
                    <% packs.forEach(producto => { %>
                        <%- include('partials/card', { producto, prefix: '' }) %>
                    <% }) %>
                </div>
            <% } %>
            <% if (prods.length > 0) { %>
                <div class="categoria-titulo">✨ Productos</div>
                <div class="productos-container">
                    <% prods.forEach(producto => { %>
                        <%- include('partials/card', { producto, prefix: '' }) %>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- ── VISTA SCOOPS ─────────────────────────────────────────── -->
        <div id="vista-scoops" style="display:none; width:100%;">
            <div class="productos-container">
                <% scoops.forEach(producto => { %>
                    <%- include('partials/card', { producto, prefix: 'sc-' }) %>
                <% }) %>
            </div>
        </div>

        <!-- ── VISTA PRODUCTOS ──────────────────────────────────────── -->
        <div id="vista-productos" style="display:none; width:100%;">
            <div class="productos-container">
                <% prods.forEach(producto => { %>
                    <%- include('partials/card', { producto, prefix: 'pr-' }) %>
                <% }) %>
            </div>
        </div>

        <!-- ── VISTA PACKS ───────────────────────────────────────────── -->
        <div id="vista-packs" style="display:none; width:100%;">
            <div class="productos-container">
                <% packs.forEach(producto => { %>
                    <%- include('partials/card', { producto, prefix: 'pk-' }) %>
                <% }) %>
            </div>
        </div>
    <% } %>
</main>

<!-- MODAL CARRITO -->
<div class="modal-overlay" id="modal-carrito">
    <div class="modal-content">
        <button class="close-modal" onclick="cerrarCarrito()">✕</button>

        <!-- PASO 1: LISTA -->
        <div id="paso-1">
            <h2 style="color:var(--piko-pink);text-align:center;font-weight:800;margin-bottom:20px;">Tu Carrito ✨</h2>
            <div id="lista-carrito" style="max-height:300px;overflow-y:auto;margin-bottom:20px;"></div>
            <div style="border-top:2px dashed #f0f0f0;padding-top:20px;">
                <div style="display:flex;justify-content:space-between;font-weight:800;font-size:1.3rem;color:var(--piko-dark);margin-bottom:15px;">
                    <span>TOTAL</span>
                    <span><span id="total-modal">0.00</span> BS</span>
                </div>
                <button class="btn-add" style="width:100%;" onclick="irAPaso2()">CONTINUAR AL ENVÍO</button>
            </div>
        </div>

        <!-- PASO 2: DATOS DE ENVÍO -->
        <div id="paso-2" style="display:none;">
            <button onclick="irAPaso1()" style="background:none;border:none;color:#aaa;margin-bottom:15px;cursor:pointer;font-weight:600;">← Volver al carrito</button>
            <h2 style="text-align:center;color:var(--piko-pink);font-weight:800;margin-bottom:15px;">Datos de Envío</h2>

            <div style="display:flex;flex-direction:column;gap:12px;">
                <input type="text" id="f-nombre" placeholder="Nombre completo" class="piko-input">
                <input type="tel" id="f-celular" placeholder="WhatsApp (ej. 77123456)" class="piko-input">

                <select id="f-ciudad" class="piko-input" onchange="gestionarTransportadora()">
                    <option value="">-- Selecciona ciudad --</option>
                    <option value="Sucre">Sucre (Chuquisaca)</option>
                    <option value="La Paz">La Paz</option>
                    <option value="El Alto">El Alto (La Paz)</option>
                    <option value="Oruro">Oruro</option>
                    <option value="Potosí">Potosí</option>
                    <option value="Villazon">Villazon (Potosí)</option>
                    <option value="Tupiza">Tupiza (Potosí)</option>
                    <option value="Uyuni">Uyuni (Potosí)</option>
                    <option value="Cochabamba">Cochabamba</option>
                    <option value="Quillacollo">Quillacollo (Cochabamba)</option>
                    <option value="Tarija">Tarija</option>
                    <option value="Yotala">Yotala (Chuquisaca)</option>
                    <option value="Beremejo">Beremejo (Tarija)</option>
                    <option value="Camargo">Camargo (Tarija)</option>
                    <option value="Santa Cruz">Santa Cruz</option>
                    <option value="Beni">Beni</option>
                    <option value="Pando">Pando</option>
                    <option value="Otra">Otra ciudad (escribir)</option>
                </select>

                <input type="text" id="otra-ciudad" placeholder="Especifica tu ciudad" class="piko-input hidden">

                <!-- SUCRE -->
                <div id="opciones-sucre" class="hidden">
                    <label style="font-size:0.9rem;font-weight:600;color:#666;display:block;margin-bottom:8px;">¿Cómo recibirás? 📦</label>
                    <select id="recojo-sucre" class="piko-input">
                        <option value="Zona Cementerio">Recojo - Zona Cementerio</option>
                        <option value="Plaza 25 de Mayo">Recojo - Plaza 25 de Mayo</option>
                        <option value="Correos">Recojo - Correos</option>
                        <option value="Delivery Sucre">Delivery a domicilio (+10 BS)</option>
                    </select>
                </div>

                <!-- OTRAS CIUDADES -->
                <div id="opciones-transportadora" class="hidden">
                    <label style="font-size:0.9rem;font-weight:600;color:#666;display:block;margin-bottom:8px;">Transportadora 🚚</label>
                    <select id="f-transportadora" class="piko-input" onchange="mostrarCampoTransportadora()">
                        <option value="">-- Selecciona transportadora --</option>
                        <option value="Amazon Express">Amazon Express (Capitales)</option>
                        <option value="Rapiditos del Sur">Rapiditos del Sur (Potosí, Tarija)</option>
                        <option value="San Miguel">San Miguel (Oruro)</option>
                        <option value="El Mexicano">El Mexicano (Tarija, El Alto, La Paz, Santa Cruz, Camargo)</option>
                        <option value="Bolivar">Bolívar (Cochabamba, Quillacollo, La Paz)</option>
                        <option value="El Dorado">El Dorado (Capitales + El Alto, Quillacollo)</option>
                        <option value="Bustillos">Bustillos (Oruro)</option>
                        <option value="Quirquincho">Quirquincho (Cochabamba, La Paz, Quillacollo)</option>
                        <option value="Copacabana">Copacabana (Capitales + El Alto, Quillacollo)</option>
                        <option value="Otra">Otra transportadora (escribir)</option>
                    </select>
                    <input type="text" id="f-otra-transportadora" placeholder="Nombre de la transportadora" class="piko-input hidden" style="margin-top:8px;">

                    <!-- SUCURSAL -->
                    <div id="bloque-sucursal" class="hidden" style="margin-top:8px;">
                        <label style="font-size:0.85rem;font-weight:600;color:#666;display:block;margin-bottom:6px;">Sucursal / Zona 📍</label>
                        <select id="f-tipo-sucursal" class="piko-input" onchange="gestionarSucursal()">
                            <option value="Terminal">Terminal</option>
                            <option value="Otra">Otra (escribir)</option>
                        </select>
                        <input type="text" id="f-sucursal-custom" placeholder="Escribe la sucursal o zona" class="piko-input hidden" style="margin-top:8px;">
                    </div>

                    <!-- PAGANDO / POR PAGAR -->
                    <div id="bloque-pago-envio" class="hidden" style="margin-top:8px;">
                        <label style="font-size:0.85rem;font-weight:600;color:#666;display:block;margin-bottom:6px;">Costo de envío 💳</label>
                        <p style="font-size:0.75rem;color:#aaa;margin-bottom:8px;">El costo de envío NO está incluido en el recibo. Te lo confirmamos por WhatsApp.</p>
                        <div class="pago-envio-selector">
                            <button type="button" class="pago-envio-btn selected" id="btn-pagando" onclick="seleccionarPagoEnvio('pagando')">
                                💵 Pagando aquí
                            </button>
                            <button type="button" class="pago-envio-btn" id="btn-porpagar" onclick="seleccionarPagoEnvio('porpagar')">
                                📦 Por pagar allá
                            </button>
                        </div>
                    </div>
                </div>

                <!-- CÓDIGO DE DESCUENTO -->
                <div style="margin-top:4px;">
                    <label style="font-size:0.85rem;font-weight:600;color:#666;display:block;margin-bottom:6px;">¿Tienes un código de descuento? 🎁</label>
                    <div class="descuento-wrapper" id="descuento-input-row">
                        <input type="text" id="f-codigo-desc" placeholder="Ej: DGRUPO10" class="piko-input" style="text-transform:uppercase;">
                        <button type="button" class="btn-aplicar-desc" onclick="aplicarDescuento()">APLICAR</button>
                    </div>
                    <div id="descuento-badge" style="margin-top:8px;display:none;"></div>
                </div>

                <!-- RESUMEN TOTAL -->
                <div style="background:var(--piko-pastel);padding:15px;border-radius:10px;">
                    <div id="fila-subtotal" style="display:none;justify-content:space-between;font-size:0.9rem;color:#888;margin-bottom:6px;">
                        <span>Subtotal</span>
                        <span><span id="subtotal-label">0.00</span> BS</span>
                    </div>
                    <div id="fila-descuento" style="display:none;justify-content:space-between;font-size:0.9rem;color:#2d7a4f;font-weight:700;margin-bottom:6px;">
                        <span>Descuento 🎉</span>
                        <span>−<span id="descuento-label">0.00</span> BS</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-weight:800;color:var(--piko-pink);font-size:1.1rem;">
                        <span>Total a pagar:</span>
                        <span><span id="total-final">0.00</span> BS</span>
                    </div>
                    <p style="font-size:0.7rem;color:#bbb;margin-top:6px;text-align:center;">* Costo de envío no incluido — se coordina por WhatsApp</p>
                </div>

                <button type="button" id="btn-piko-final" class="btn-add" style="width:100%;padding:12px;font-weight:700;" onclick="enviarPedido()">CONFIRMAR PEDIDO</button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
let carrito = JSON.parse(localStorage.getItem('piko_cart')) || [];

// ── DESCUENTOS ────────────────────────────────────────────────────────────────
// Válido: domingo 6 abril 2026 00:00 → domingo 13 abril 2026 23:59 (hora Bolivia UTC-4)
const CODIGOS_DESCUENTO = {
    'DGRUPO10': {
        tipo: 'porcentaje',
        valor: 10,
        desde: new Date('2026-04-06T00:00:00-04:00'),
        hasta: new Date('2026-04-13T23:59:59-04:00'),
    }
};
let descuentoAplicado = null; // { codigo, tipo, valor, monto }

function aplicarDescuento() {
    const codigo = document.getElementById('f-codigo-desc').value.trim().toUpperCase();
    if (!codigo) return;

    const desc = CODIGOS_DESCUENTO[codigo];
    const ahora = new Date();

    if (!desc) {
        Swal.fire('❌ Código inválido', 'Ese código de descuento no existe.', 'error');
        return;
    }
    if (ahora < desc.desde || ahora > desc.hasta) {
        Swal.fire('⏰ Código vencido', 'Este código ya no está activo.', 'warning');
        return;
    }

    const subtotal = carrito.reduce((acc, p) => acc + p.precio * p.cantidad, 0);
    const monto = desc.tipo === 'porcentaje'
        ? parseFloat((subtotal * desc.valor / 100).toFixed(2))
        : desc.valor;

    descuentoAplicado = { codigo, tipo: desc.tipo, valor: desc.valor, monto };
    actualizarTotalesConDescuento(subtotal);

    // Ocultar input y mostrar badge
    document.getElementById('descuento-input-row').classList.add('hidden');
    const badge = document.getElementById('descuento-badge');
    badge.style.display = 'block';
    badge.innerHTML =
        '<span class="desc-badge">' +
            '✅ ' + codigo + ' — ' + desc.valor + '% aplicado' +
            ' <button onclick="quitarDescuento()" title="Quitar">✕</button>' +
        '</span>';

    Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 }).fire({
        icon: 'success', title: '¡Descuento aplicado! −' + monto.toFixed(2) + ' BS'
    });
}

function quitarDescuento() {
    descuentoAplicado = null;
    document.getElementById('f-codigo-desc').value = '';
    document.getElementById('descuento-input-row').classList.remove('hidden');
    document.getElementById('descuento-badge').style.display = 'none';
    const subtotal = carrito.reduce((acc, p) => acc + p.precio * p.cantidad, 0);
    actualizarTotalesConDescuento(subtotal);
}

function actualizarTotalesConDescuento(subtotal) {
    const monto = descuentoAplicado ? descuentoAplicado.monto : 0;
    const totalFinal = Math.max(0, subtotal - monto);

    // Filas de desglose
    document.getElementById('fila-subtotal').style.display  = monto > 0 ? 'flex' : 'none';
    document.getElementById('fila-descuento').style.display = monto > 0 ? 'flex' : 'none';
    document.getElementById('subtotal-label').innerText  = subtotal.toFixed(2);
    document.getElementById('descuento-label').innerText = monto.toFixed(2);
    document.getElementById('total-final').innerText     = totalFinal.toFixed(2);
}

// ── PAGO DE ENVÍO ─────────────────────────────────────────────────────────────
let pagoEnvioSeleccionado = 'pagando';

function seleccionarPagoEnvio(opcion) {
    pagoEnvioSeleccionado = opcion;
    document.getElementById('btn-pagando').classList.toggle('selected',  opcion === 'pagando');
    document.getElementById('btn-porpagar').classList.toggle('selected', opcion === 'porpagar');
}

// ── NAVBAR OFFSET ─────────────────────────────────────────────────────────────
function ajustarOffsetNavbar() {
    const navbar  = document.getElementById('main-navbar');
    const banner  = document.getElementById('banner-wrapper');
    const ticker  = document.querySelector('.ticker-wrapper');
    if (!navbar || !banner) return;
    const tickerH = ticker ? ticker.getBoundingClientRect().height : 0;
    const navbarH = navbar.getBoundingClientRect().height;
    banner.style.marginTop = (tickerH + navbarH) + 'px';
}
window.addEventListener('load',   ajustarOffsetNavbar);
window.addEventListener('resize', ajustarOffsetNavbar);
document.fonts && document.fonts.ready.then(ajustarOffsetNavbar);

document.addEventListener('DOMContentLoaded', () => {
    ajustarOffsetNavbar();
    actualizarUI();
});

// ── CARRITO ────────────────────────────────────────────────────────────────────
function guardarCarrito() { localStorage.setItem('piko_cart', JSON.stringify(carrito)); }

function sumarCantidad(id) { const i = document.getElementById('cant-'+id); if(i) i.value = parseInt(i.value)+1; }
function restarCantidad(id) { const i = document.getElementById('cant-'+id); if(i && parseInt(i.value)>1) i.value = parseInt(i.value)-1; }

function cambiarCantidadCarrito(idx, delta) {
    carrito[idx].cantidad += delta;
    if (carrito[idx].cantidad < 1) carrito[idx].cantidad = 1;
    actualizarUI();
}

// ── VARIANTE DE PRECIO ───────────────────────────────────────────────────────
function cambiarVariante(pid) {
    const sel = document.getElementById('variante-'+pid);
    if (!sel) return;
    const precio = parseInt(sel.value);
    const display = document.getElementById('precio-display-'+pid);
    if (display) display.innerText = precio + ' BS';
}

// ── AGREGAR AL CARRITO ────────────────────────────────────────────────────────
// pid       = id con prefijo de vista (para leer el input correcto)
// modoVar   = 'variante' si el producto tiene selector de precio variable
// modoSub   = 'subtipo'  si el producto tiene selector de subtipo
function agregarAlCarrito(id, titulo, img, pid, modoVar, modoSub) {
    const inp = document.getElementById('cant-'+pid);
    const cantidad = inp ? parseInt(inp.value) : 1;

    // Precio: desde el selector de variante o desde el atributo fijo
    let precio;
    if (modoVar === 'variante') {
        const sel = document.getElementById('variante-'+pid);
        precio = sel ? parseInt(sel.value) : 0;
    } else {
        // Leer el precio del texto de la card (primer número antes de "BS")
        const priceEl = inp ? inp.closest('.card-info').querySelector('.price') : null;
        precio = priceEl ? parseInt(priceEl.innerText) : 0;
    }

    // Subtipo
    let subtipo = '';
    if (modoSub === 'subtipo') {
        const selSub = document.getElementById('subtipo-'+pid);
        subtipo = selSub ? selSub.value : '';
    }

    // Etiqueta de variante para mostrar en carrito y recibo
    let etiqueta = titulo;
    if (modoVar === 'variante') {
        const selVar = document.getElementById('variante-'+pid);
        if (selVar) {
            const opt = selVar.options[selVar.selectedIndex];
            // data-label tiene solo el nombre sin el precio
            const label = opt.getAttribute('data-label') || opt.text.split(' — ')[0];
            etiqueta += ' (' + label + ')';
        }
    }
    if (subtipo) etiqueta += ' — ' + subtipo;

    // Clave única = id + variante + subtipo (para no mezclar variantes distintas)
    const clave = id + '|' + (modoVar === 'variante' ? precio : '') + '|' + subtipo;
    const existe = carrito.find(p => p.clave === clave);
    if (existe) {
        existe.cantidad += cantidad;
    } else {
        carrito.push({ id, clave, titulo: etiqueta, img, precio, cantidad });
    }

    if (inp) inp.value = 1;
    Swal.mixin({ toast:true, position:'top-end', showConfirmButton:false, timer:1500 }).fire({ icon:'success', title:'¡Añadido! ✨' });
    actualizarUI();
}

function actualizarUI() {
    let subtotal = 0, unidades = 0;
    const lista = document.getElementById('lista-carrito');

    lista.innerHTML = carrito.map((p, idx) => {
        const sub = p.precio * p.cantidad;
        subtotal += sub; unidades += p.cantidad;
        return '<div class="carrito-item">' +
            '<img src="'+p.img+'" alt="'+p.titulo+'">' +
            '<div class="carrito-item-info">' +
                '<div class="carrito-item-nombre">'+p.titulo+'</div>' +
                '<div class="carrito-item-precio">'+sub.toFixed(2)+' BS</div>' +
            '</div>' +
            '<div class="carrito-item-controles">' +
                '<button onclick="cambiarCantidadCarrito('+idx+',-1)">−</button>' +
                '<span>'+p.cantidad+'</span>' +
                '<button onclick="cambiarCantidadCarrito('+idx+',1)">+</button>' +
            '</div>' +
            '<button class="carrito-item-borrar" onclick="carrito.splice('+idx+',1);actualizarUI();">×</button>' +
        '</div>';
    }).join('');

    if (carrito.length === 0) lista.innerHTML = "<div style='text-align:center;color:#bbb;padding:30px;'>Tu carrito está vacío 🌸</div>";

    const monto = descuentoAplicado ? descuentoAplicado.monto : 0;
    const totalFinal = Math.max(0, subtotal - monto);

    document.getElementById('nav-total-bs').innerText     = totalFinal.toFixed(2);
    document.getElementById('total-modal').innerText       = subtotal.toFixed(2);
    document.getElementById('cart-count-badge').innerText  = unidades;

    actualizarTotalesConDescuento(subtotal);
    guardarCarrito();
}

