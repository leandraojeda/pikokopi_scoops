<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Piko Kopi Shop 🌸</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root { --piko-pink: #ff85a2; --piko-pastel: #fff5f7; --piko-dark: #2c2c2c; }
        
        /* Estilos generales */
        .cart-wrapper { position: relative; cursor: pointer; display: inline-block; }
        #cart-count-badge {
            position: absolute; top: -5px; right: -8px;
            background: var(--piko-pink); color: white;
            font-size: 0.65rem; font-weight: 800;
            min-width: 18px; height: 18px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid white; transform: scale(0); opacity: 0;
            transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        #cart-count-badge.visible { transform: scale(1); opacity: 1; }
        
        /* Inputs minimalistas */
        .input-piko { padding: 12px; border-radius: 12px; border: 1px solid #ffdae0; font-family: 'Poppins'; outline: none; transition: 0.3s; font-size: 0.9rem; }
        .input-piko:focus { border-color: var(--piko-pink); box-shadow: 0 0 8px rgba(255, 133, 162, 0.15); }
        
        /* SELECTOR DE CANTIDAD - MINIMALISTA */
        .cantidad-selector {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f5f5f5;
            padding: 6px 10px;
            border-radius: 8px;
            width: fit-content;
        }

        .cantidad-btn {
            background: none;
            border: none;
            color: var(--piko-pink);
            font-size: 16px;
            cursor: pointer;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
            border-radius: 4px;
        }

        .cantidad-btn:hover {
            background: var(--piko-pink);
            color: white;
            transform: scale(1.1);
        }

        .cantidad-input {
            width: 40px;
            border: none;
            background: white;
            text-align: center;
            font-weight: 700;
            color: var(--piko-dark);
            font-size: 14px;
            border-radius: 4px;
            padding: 4px;
            font-family: 'Poppins';
        }

        .cantidad-input::-webkit-outer-spin-button,
        .cantidad-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Botón WhatsApp Aesthetic */
        .swal-piko-button {
            text-decoration: none; 
            background: #25D366; 
            color: white !important; 
            padding: 16px; 
            border-radius: 15px; 
            font-weight: 700; 
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 12px;
            font-family: 'Poppins', sans-serif;
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2);
            width: 100%;
            border: none;
            cursor: pointer;
        }
        .swal-piko-button:hover { background: #128C7E; transform: translateY(-2px); }

        /* Botón descargar recibo */
        .swal-piko-button-descargar {
            text-decoration: none; 
            background: var(--piko-pink); 
            color: white !important; 
            padding: 16px; 
            border-radius: 15px; 
            font-weight: 700; 
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 12px;
            font-family: 'Poppins', sans-serif;
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(255, 133, 162, 0.2);
            width: 100%;
            border: none;
            cursor: pointer;
        }
        .swal-piko-button-descargar:hover { background: #ff6b8a; transform: translateY(-2px); }

        /* ESTILOS PARA CATEGORÍAS */
        .categoria-titulo {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--piko-dark);
            margin-top: 40px;
            margin-bottom: 20px;
            padding-left: 20px;
            border-left: 4px solid var(--piko-pink);
        }

        .hidden { display: none; }
        /* --- ESTO ES LO QUE ARREGLA LAS 4 COLUMNAS --- */

/* Contenedor principal para que no se pegue a los bordes en PC */
.productos-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 20px;
}

/* Configuración de la fila de productos */
.productos-row, 
#vista-scoops, 
#vista-productos-cat, 
#vista-packs {
    display: grid !important; /* Forzamos el uso de Grid */
    grid-template-columns: repeat(4, 1fr); /* 4 columnas exactas */
    gap: 20px; /* Espacio entre cards */
    margin-bottom: 40px;
}

/* Estilo básico para la Card (para que no se desparrame) */
.card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
}

.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.card-info {
    padding: 15px;
}

/* --- RESPONSIVE: Para que en celular no se vea minúsculo --- */
@media (max-width: 1024px) {
    .productos-row, #vista-scoops, #vista-productos-cat, #vista-packs {
        grid-template-columns: repeat(3, 1fr); /* 3 columnas en tablets */
    }
}

@media (max-width: 768px) {
    .productos-row, #vista-scoops, #vista-productos-cat, #vista-packs {
        grid-template-columns: repeat(2, 1fr); /* 2 columnas en celulares */
        gap: 10px;
    }
}
    </style>
</head>
<body>

<%- include('partials/header') %>

<nav class="navbar">
    <div class="nav-left">
        <a href="/" class="logo">PIKO <span>KOPI</span></a>
    </div>
    <div class="nav-center">
        <button class="filter-btn active" onclick="filtrar('todos', this)">TODOS</button>
        <button class="filter-btn" onclick="filtrar('scoops', this)">SCOOPS</button>
        <button class="filter-btn" onclick="filtrar('productos', this)">PRODUCTOS</button>
        <button class="filter-btn" onclick="filtrar('packs', this)">PACKS</button>
    </div>
    <div class="nav-right" style="display: flex; align-items: center; gap: 15px;">
        <div style="font-weight: 800; color: var(--piko-pink);"><span id="nav-total-bs">0</span> BS</div>
        <div class="cart-wrapper" onclick="abrirCarrito()">
            <i class="fa-solid fa-cart-shopping" style="font-size: 1.3rem;"></i>
            <span id="cart-count-badge">0</span>
        </div>
    </div>
</nav>

